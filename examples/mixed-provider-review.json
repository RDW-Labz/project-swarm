{
  "version": 1,
  "concurrency": 4,
  "jobs": [
    {
      "id": "setup",
      "agent": "openai",
      "sensitive": false,
      "prompt": "Review only the setup guidance in README.md. Give concrete evidence and a concise improvement proposal. Do not run tests.",
      "context": [
        "README.md"
      ],
      "outputs": [
        "coordination/setup-review.md"
      ],
      "timeoutMs": 180000,
      "model": "gpt-4.1-mini",
      "maxOutputTokens": 4096
    },
    {
      "id": "scope",
      "agent": "gemini",
      "sensitive": false,
      "prompt": "Review only the scope guidance in README.md. Give concrete evidence and a concise improvement proposal. Do not run tests.",
      "context": [
        "README.md"
      ],
      "outputs": [
        "coordination/scope-review.md"
      ],
      "timeoutMs": 180000,
      "model": "gemini-2.5-flash",
      "maxOutputTokens": 4096
    },
    {
      "id": "workflow",
      "agent": "ollama",
      "prompt": "Review only the workflow guidance in README.md. Give concrete evidence and a concise improvement proposal. Do not run tests.",
      "context": [
        "README.md"
      ],
      "outputs": [
        "coordination/workflow-review.md"
      ],
      "timeoutMs": 180000,
      "model": "qwen3:8b",
      "maxOutputTokens": 4096
    },
    {
      "id": "recovery",
      "agent": "claude",
      "model": "sonnet",
      "prompt": "Review only the recovery guidance in README.md. Give concrete evidence and a concise improvement proposal. Do not run tests.",
      "context": [
        "README.md"
      ],
      "outputs": [
        "coordination/recovery-review.md"
      ],
      "timeoutMs": 180000
    }
  ]
}
