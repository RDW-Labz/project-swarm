+const SELECTOR_TOKEN = /^(?:([a-zA-Z][\w-]*)|#([\w-]+)|\.([\w-]+)|\[([\w-]+)(?:="([^"]*)")?\])/;
+
+function parseCompound(text) {
+  const out = { tag: null, id: null, classes: [], attrs: [] };
