+  const { superseded } = supersededSplitParks(events);
+  assert.deepEqual(
+    superseded.map(s => [s.id, s.newerRun]).sort(),
+    [['split-park-S1-T-0001', 'r1-new'], ['split-park-S2-T-0003', 'r2-new']].sort(),
