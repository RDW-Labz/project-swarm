diff --git a/tests/integrate-commit-branches.test.mjs b/tests/integrate-commit-branches.test.mjs
new file mode 100644
index 00000000..fb73e0f1
--- /dev/null
+++ b/tests/integrate-commit-branches.test.mjs
@@ -0,0 +1,166 @@
+// SPDX-License-Identifier: Apache-2.0
+import './_isolate-config.mjs';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { execFile } from 'node:child_process';
+import { promisify } from 'node:util';
+import {
+  commitIntegratedRun,
+  branchAllowedForIntegrateCommit,
+  readIntegrateCommitBranches,
+} from '../tools/go.mjs';
+
+const exec = promisify(execFile);
+const gitEnv = root => ({ GIT_CONFIG_GLOBAL: '/dev/null', GIT_CONFIG_SYSTEM: '/dev/null', TMPDIR: root });
+const digest = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
+
+async function git(root, ...args) {
+  return exec('git', ['-C', root, ...args], { env: { ...process.env, ...gitEnv(root) } });
+}
+
+async function fixture(t, { branch = 'swarm/test', projectSwarm = null } = {}) {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), 'swarm-commit-branches-'));
+  t.after(() => fs.rm(root, { recursive: true, force: true }));
+  await fs.mkdir(path.join(root, 'out'), { recursive: true });
+  await fs.writeFile(path.join(root, 'out/change.txt'), 'base\n');
+  await git(root, 'init', '-q');
+  await git(root, 'config', 'user.name', 'Swarm Test');
+  await git(root, 'config', 'user.email', 'test@example.invalid');
+  await git(root, 'add', '.');
+  await git(root, 'commit', '-qm', 'fixture');
+  if (branch) {
+    if (branch === 'main') {
+      await git(root, 'branch', '-M', 'main');
+    } else {
+      await git(root, 'checkout', '-q', '-b', branch);
+    }
+  }
+  if (projectSwarm !== null) {
+    await fs.writeFile(path.join(root, '.project-swarm.json'), `${JSON.stringify(projectSwarm)}\n`);
+  }
+  await fs.writeFile(path.join(root, 'out/change.txt'), 'integrated\n');
+  return root;
+}
+
+function integrationState(root, relPath = 'out/change.txt', content = 'integrated\n') {
+  const bytes = Buffer.from(content, 'utf8');
+  return {
+    integratedFiles: [relPath],
+    integratedHashes: { [relPath]: digest(bytes) },
+  };
+}
+
+async function headSha(root) {
+  const { stdout } = await git(root, 'rev-parse', 'HEAD');
+  return stdout.trim();
+}
+
+async function runCommit(root, { branch, projectSwarm, state, runId = 'run-test' } = {}) {
+  const stateObj = state ?? integrationState(root);
+  return commitIntegratedRun(root, {
+    runId,
+    state: stateObj,
+    manifest: { version: 1, jobs: [] },
+    env: gitEnv(root),
+  });
+}
+
+test('branchAllowedForIntegrateCommit: exact, trailing star, and lone star', () => {
+  assert.equal(branchAllowedForIntegrateCommit('build/s18-confirmation', ['build/s18-confirmation']), true);
+  assert.equal(branchAllowedForIntegrateCommit('build/s18', ['build/s18-confirmation']), false);
+  assert.equal(branchAllowedForIntegrateCommit('build/x', ['build/*']), true);
+  assert.equal(branchAllowedForIntegrateCommit('build', ['build/*']), false);
+  assert.equal(branchAllowedForIntegrateCommit('anything', ['*']), true);
+});
+
+test('commit on exact commitBranches name build/s18-confirmation', async t => {
+  const root = await fixture(t, {
+    branch: 'build/s18-confirmation',
+    projectSwarm: { integrate: { commitBranches: ['build/s18-confirmation'] } },
+  });
+  const before = await headSha(root);
+  const out = await runCommit(root);
+  assert.equal(out.commit?.status, 'committed');
+  assert.notEqual(await headSha(root), before);
+});
+
+test('commit on pattern build/* for build/x', async t => {
+  const root = await fixture(t, {
+    branch: 'build/x',
+    projectSwarm: { integrate: { commitBranches: ['build/*'] } },
+  });
+  const out = await runCommit(root);
+  assert.equal(out.commit?.status, 'committed');
+});
+
+test('unnamed non-swarm branch skips with configured reason and HEAD unchanged', async t => {
+  const root = await fixture(t, { branch: 'feature/unlisted' });
+  const before = await headSha(root);
+  const out = await runCommit(root);
+  assert.equal(out.commit?.status, 'skipped');
+  assert.match(out.commit?.reason, /not a swarm\/\* branch or a branch named in \.project-swarm\.json integrate\.commitBranches/);
+  assert.equal(await headSha(root), before);
+});
+
+test('main is never committed when listed in commitBranches or lone star', async t => {
+  for (const projectSwarm of [{ integrate: { commitBranches: ['main'] } }, { integrate: { commitBranches: ['*'] } }]) {
+    const root = await fixture(t, { branch: 'main', projectSwarm });
+    const before = await headSha(root);
+    const out = await runCommit(root);
+    assert.equal(out.commit?.status, 'skipped');
+    assert.match(out.commit?.reason, /the main branch; integrate never commits there/);
+    assert.equal(await headSha(root), before);
+  }
+});
+
+test('default branch from origin/HEAD is never committed when named in commitBranches', async t => {
+  const root = await fixture(t, { branch: 'develop' });
+  await git(root, 'branch', '-M', 'develop');
+  await git(root, 'remote', 'add', 'origin', root);
+  await git(root, 'fetch', 'origin');
+  await git(root, 'symbolic-ref', 'refs/remotes/origin/HEAD', 'refs/remotes/origin/develop');
+  const before = await headSha(root);
+  await fs.writeFile(
+    path.join(root, '.project-swarm.json'),
+    `${JSON.stringify({ integrate: { commitBranches: ['develop'] } })}\n`,
+  );
+  const out = await runCommit(root);
+  assert.equal(out.commit?.status, 'skipped');
+  assert.match(out.commit?.reason, /the main branch; integrate never commits there/);
+  assert.equal(await headSha(root), before);
+});
+
+test('swarm/* commits with no project config', async t => {
+  const root = await fixture(t, { branch: 'swarm/no-config' });
+  const out = await runCommit(root);
+  assert.equal(out.commit?.status, 'committed');
+});
+
+test('invalid JSON and bad commitBranches skip naming integrate.commitBranches', async t => {
+  const root = await fixture(t, { branch: 'swarm/bad-config' });
+  await fs.writeFile(path.join(root, '.project-swarm.json'), '{ not json\n');
+  let out = await runCommit(root);
+  assert.equal(out.commit?.status, 'skipped');
+  assert.match(out.commit?.reason, /\.project-swarm\.json integrate\.commitBranches/);
+
+  await fs.writeFile(
+    path.join(root, '.project-swarm.json'),
+    `${JSON.stringify({ integrate: { commitBranches: 'not-array' } })}\n`,
+  );
+  out = await runCommit(root);
+  assert.equal(out.commit?.status, 'skipped');
+  assert.match(out.commit?.reason, /integrate\.commitBranches must be an array of non-empty strings/);
+});
+
+test('readIntegrateCommitBranches returns patterns from valid file', async t => {
+  const root = await fixture(t, {
+    projectSwarm: { integrate: { commitBranches: ['build/*'] } },
+  });
+  const { patterns, error } = await readIntegrateCommitBranches(root);
+  assert.equal(error, null);
+  assert.deepEqual(patterns, ['build/*']);
+});
diff --git a/tests/om-manifest-guard.test.mjs b/tests/om-manifest-guard.test.mjs
new file mode 100644
index 00000000..266dc4a2
--- /dev/null
+++ b/tests/om-manifest-guard.test.mjs
@@ -0,0 +1,274 @@
+// SPDX-License-Identifier: Apache-2.0
+import './_isolate-config.mjs';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import fsSync from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { omRunManifestVetted } from '../tools/om-manifest-guard.mjs';
+import { orchestratorModeCommandAllowed } from '../tools/shell-writes.mjs';
+
+const SWARM_MJS = fileURLToPath(new URL('../tools/swarm.mjs', import.meta.url));
+
+async function installLocalSwarmShim() {
+  const binDir = path.join(process.env.HOME, '.local', 'bin');
+  await fs.mkdir(binDir, { recursive: true });
+  const wrapper = `#!/bin/sh\n# managed by project-swarm\nexec ${JSON.stringify(process.execPath)} ${JSON.stringify(SWARM_MJS)} "$@"\n`;
+  await fs.writeFile(path.join(binDir, 'swarm'), wrapper, { mode: 0o755 });
+  process.env.PATH = `${binDir}:${process.env.PATH ?? ''}`;
+}
+
+const tmp = async t => {
+  const d = await fs.realpath(await fs.mkdtemp(path.join(os.tmpdir(), 'swarm-om-manifest-')));
+  t.after(() => fs.rm(d, { recursive: true, force: true }));
+  return d;
+};
+
+const EVIL_CHECK = ['sh', '-c', 'touch src/x'];
+const VETTED_NAME = 'safe-check';
+
+async function projectFixture(t, { checksArgv = EVIL_CHECK, includeProfileVerify = false } = {}) {
+  const root = await tmp(t);
+  await fs.mkdir(path.join(root, '.git'));
+  await fs.mkdir(path.join(root, '.swarm', 'runs'), { recursive: true });
+  await fs.mkdir(path.join(root, 'coordination', 'manifests'), { recursive: true });
+  await fs.mkdir(path.join(root, 'src'), { recursive: true });
+  const checks = checksArgv === null
+    ? []
+    : [{ name: VETTED_NAME, argv: checksArgv }];
+  await fs.writeFile(
+    path.join(root, 'coordination', 'checks.json'),
+    `${JSON.stringify({ checks }, null, 2)}\n`,
+  );
+  if (includeProfileVerify) {
+    await fs.writeFile(
+      path.join(root, '.project-swarm.json'),
+      `${JSON.stringify({
+        profile: {
+          verify: {
+            command: ['npm', 'test'],
+            setup: [['npm', 'ci']],
+          },
+        },
+      }, null, 2)}\n`,
+    );
+  }
+  return root;
+}
+
+async function writeManifest(root, rel, body) {
+  const full = path.join(root, rel);
+  await fs.mkdir(path.dirname(full), { recursive: true });
+  await fs.writeFile(full, `${JSON.stringify(body, null, 2)}\n`);
+}
+
+test('omRunManifestVetted refuses custom checks argv', async t => {
+  const root = await projectFixture(t, { checksArgv: ['npm', 'test'] });
+  const rel = 'coordination/manifests/m.json';
+  await writeManifest(root, rel, {
+    version: 1,
+    jobs: [{ id: 'j1', prompt: 'do work', outputs: [] }],
+    checks: [{ name: 'evil', argv: EVIL_CHECK }],
+  });
+  const r = omRunManifestVetted(root, rel);
+  assert.equal(r.ok, false);
+  assert.match(r.reason, /checks/);
+  assert.match(r.reason, /coordination\/checks\.json/);
+});
+
+test('orchestratorModeCommandAllowed denies swarm run with unvetted manifest', async t => {
+  await installLocalSwarmShim();
+  const root = await projectFixture(t, { checksArgv: ['npm', 'test'] });
+  const rel = 'coordination/manifests/m.json';
+  await writeManifest(root, rel, {
+    version: 1,
+    jobs: [{ id: 'j1', prompt: 'work', outputs: [] }],
+    checks: [{ name: 'evil', argv: EVIL_CHECK }],
+  });
+  const ctx = { root, cwd: root };
+  assert.equal(orchestratorModeCommandAllowed(`swarm run ${rel}`, ctx), false);
+});
+
+test('vetted checks argv in manifest is allowed', async t => {
+  await installLocalSwarmShim();
+  const root = await projectFixture(t, { checksArgv: EVIL_CHECK });
+  const rel = 'coordination/manifests/m.json';
+  await writeManifest(root, rel, {
+    version: 1,
+    jobs: [{ id: 'j1', prompt: 'work', outputs: [] }],
+    checks: [{ name: VETTED_NAME, argv: EVIL_CHECK }],
+  });
+  assert.equal(omRunManifestVetted(root, rel).ok, true);
+  assert.equal(orchestratorModeCommandAllowed(`swarm run ${rel}`, { root, cwd: root }), true);
+});
+
+test('profile verify.command argv is allowed in manifest', async t => {
+  const root = await projectFixture(t, { checksArgv: ['node', '--test'], includeProfileVerify: true });
+  const rel = 'coordination/manifests/m.json';
+  await writeManifest(root, rel, {
+    version: 1,
+    jobs: [{ id: 'j1', prompt: 'work', outputs: [] }],
+    checks: [{ name: 'profile', argv: ['npm', 'test'] }],
+  });
+  assert.equal(omRunManifestVetted(root, rel).ok, true);
+});
+
+test('plain job manifest with no commands is allowed', async t => {
+  const root = await projectFixture(t, { checksArgv: null });
+  const rel = 'coordination/manifests/plain.json';
+  await writeManifest(root, rel, {
+    version: 1,
+    jobs: [{ id: 'j1', prompt: 'work', outputs: ['src/a.ts'] }],
+  });
+  assert.equal(omRunManifestVetted(root, rel).ok, true);
+});
+
+test('setup preChecks mutantCheck refused when unvetted', async t => {
+  const root = await projectFixture(t, { checksArgv: ['npm', 'test'] });
+  const base = {
+    version: 1,
+    jobs: [{ id: 'j1', prompt: 'work', outputs: [] }],
+  };
+  const relSetup = 'coordination/manifests/setup.json';
+  await writeManifest(root, relSetup, { ...base, setup: [EVIL_CHECK] });
+  assert.equal(omRunManifestVetted(root, relSetup).ok, false);
+  assert.match(omRunManifestVetted(root, relSetup).reason, /setup/);
+
+  const relPre = 'coordination/manifests/pre.json';
+  await writeManifest(root, relPre, { ...base, preChecks: [{ name: 'p', argv: EVIL_CHECK }] });
+  assert.equal(omRunManifestVetted(root, relPre).ok, false);
+  assert.match(omRunManifestVetted(root, relPre).reason, /preChecks/);
+
+  const relMut = 'coordination/manifests/mut.json';
+  await writeManifest(root, relMut, { ...base, mutantCheck: EVIL_CHECK });
+  assert.equal(omRunManifestVetted(root, relMut).ok, false);
+  assert.match(omRunManifestVetted(root, relMut).reason, /mutantCheck/);
+
+  const relJob = 'coordination/manifests/job-check.json';
+  await writeManifest(root, relJob, {
+    ...base,
+    jobs: [{ id: 'j1', prompt: 'work', outputs: [], checks: [{ name: 'c', argv: EVIL_CHECK }] }],
+  });
+  assert.equal(omRunManifestVetted(root, relJob).ok, false);
+  assert.match(omRunManifestVetted(root, relJob).reason, /jobs/);
+});
+
+test('shell job and sonnet-shell model refused', async t => {
+  const root = await projectFixture(t, { checksArgv: null });
+  const relShell = 'coordination/manifests/shell.json';
+  await writeManifest(root, relShell, {
+    version: 1,
+    jobs: [{ id: 'evil-shell', shell: true, prompt: 'id', outputs: [] }],
+  });
+  const rShell = omRunManifestVetted(root, relShell);
+  assert.equal(rShell.ok, false);
+  assert.match(rShell.reason, /evil-shell/);
+
+  const relModel = 'coordination/manifests/model.json';
+  await writeManifest(root, relModel, {
+    version: 1,
+    jobs: [{ id: 'm1', model: 'sonnet-shell', prompt: 'work', outputs: [] }],
+  });
+  const rModel = omRunManifestVetted(root, relModel);
+  assert.equal(rModel.ok, false);
+  assert.match(rModel.reason, /sonnet-shell/);
+});
+
+test('root-level evil.json swarm run is read and refused', async t => {
+  await installLocalSwarmShim();
+  const root = await projectFixture(t, { checksArgv: null });
+  await writeManifest(root, 'evil.json', {
+    version: 1,
+    jobs: [{ id: 'j1', prompt: 'work', outputs: [] }],
+    checks: [{ name: 'evil', argv: EVIL_CHECK }],
+  });
+  assert.equal(omRunManifestVetted(root, 'evil.json').ok, false);
+  assert.equal(orchestratorModeCommandAllowed('swarm run evil.json', { root, cwd: root }), false);
+});
+
+test('bare run id with no manifest file passes', async t => {
+  await installLocalSwarmShim();
+  const root = await projectFixture(t, { checksArgv: null });
+  assert.equal(omRunManifestVetted(root, 'run-abc-123').ok, true);
+  assert.equal(orchestratorModeCommandAllowed('swarm run run-abc-123', { root, cwd: root }), true);
+});
+
+test('invalid JSON manifest refused', async t => {
+  const root = await projectFixture(t, { checksArgv: null });
+  const rel = 'coordination/manifests/bad.json';
+  await fs.writeFile(path.join(root, rel), '{ not json\n');
+  const r = omRunManifestVetted(root, rel);
+  assert.equal(r.ok, false);
+  assert.match(r.reason, /JSON/i);
+});
+
+test('symlink manifest pointing outside root refused', async t => {
+  const root = await projectFixture(t, { checksArgv: null });
+  const outside = await tmp(t);
+  const outsideManifest = path.join(outside, 'outside.json');
+  await fs.writeFile(
+    outsideManifest,
+    `${JSON.stringify({
+      version: 1,
+      jobs: [{ id: 'j1', prompt: 'work', outputs: [] }],
+      checks: [{ name: 'c', argv: EVIL_CHECK }],
+    }, null, 2)}\n`,
+  );
+  const linkRel = 'coordination/manifests/link.json';
+  const linkPath = path.join(root, linkRel);
+  await fs.symlink(outsideManifest, linkPath);
+  const r = omRunManifestVetted(root, linkRel);
+  assert.equal(r.ok, false);
+  assert.match(r.reason, /project root/i);
+});
+
+test('missing root denies json positional on swarm run', () => {
+  const r = omRunManifestVetted(undefined, 'evil.json');
+  assert.equal(r.ok, false);
+});
+
+test('orchestratorModeCommandAllowed denies swarm ticket with unvetted manifest checks', async t => {
+  await installLocalSwarmShim();
+  const root = await projectFixture(t, { checksArgv: ['npm', 'test'] });
+  const rel = 'coordination/manifests/m.json';
+  await writeManifest(root, rel, {
+    version: 1,
+    jobs: [{ id: 'j1', prompt: 'work', outputs: [] }],
+    checks: [{ name: 'evil', argv: EVIL_CHECK }],
+  });
+  const ctx = { root, cwd: root };
+  assert.equal(
+    orchestratorModeCommandAllowed(`swarm ticket ${rel} --pr coordination/manifests/p.json`, ctx),
+    false,
+  );
+});
+
+test('orchestratorModeCommandAllowed allows swarm ticket when manifest checks are vetted', async t => {
+  await installLocalSwarmShim();
+  const root = await projectFixture(t, { checksArgv: EVIL_CHECK });
+  const rel = 'coordination/manifests/m.json';
+  await writeManifest(root, rel, {
+    version: 1,
+    jobs: [{ id: 'j1', prompt: 'work', outputs: [] }],
+    checks: [{ name: VETTED_NAME, argv: EVIL_CHECK }],
+  });
+  const ctx = { root, cwd: root };
+  assert.equal(
+    orchestratorModeCommandAllowed(`swarm ticket ${rel} --pr coordination/manifests/p.json`, ctx),
+    true,
+  );
+});
+
+test('orchestratorModeCommandAllowed allows swarm ticket plain manifest', async t => {
+  await installLocalSwarmShim();
+  const root = await projectFixture(t, { checksArgv: null });
+  const rel = 'coordination/manifests/plain.json';
+  await writeManifest(root, rel, {
+    version: 1,
+    jobs: [{ id: 'j1', prompt: 'work', outputs: ['src/a.ts'] }],
+  });
+  const ctx = { root, cwd: root };
+  assert.equal(orchestratorModeCommandAllowed(`swarm ticket ${rel} --pr p.json`, ctx), true);
+});
diff --git a/tests/split-auto-approve.test.mjs b/tests/split-auto-approve.test.mjs
new file mode 100644
index 00000000..7fb6810d
--- /dev/null
+++ b/tests/split-auto-approve.test.mjs
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: Apache-2.0
+import './_isolate-config.mjs';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { evaluateAutoApprove } from '../tools/split-auto-approve.mjs';
+import { swarmSubcommandAlwaysAllowed } from '../tools/orchestrator-allow.mjs';
+import { runScopeCommand } from '../tools/scope-commands.mjs';
+import { readLedger } from '../tools/tickets.mjs';
+
+const baseTicket = (id, extra = {}) => ({
+  id,
+  title: 'Work',
+  type: 'build',
+  scopeRefs: ['R-001'],
+  acceptance: ['ok'],
+  files: ['src/a.mjs'],
+  size: 'S',
+  risk: 'low',
+  status: 'todo',
+  stage: 'S1',
+  ...extra,
+});
+
+const baseSnapshot = (tickets, changeOrderIds = []) => ({
+  at: '2024-01-01T00:00:00.000Z',
+  by: 'owner',
+  ticketsHash: 'abc',
+  changeOrderIds,
+  tickets,
+});
+
+const passingLedger = (snapshot, { extraTickets = [], changeOrders = [{ id: 'CO-001' }] } = {}) => ({
+  tickets: [...snapshot.tickets, ...extraTickets],
+  changeOrders,
+});
+
+test('evaluateAutoApprove: all conditions pass', () => {
+  const snap = baseSnapshot([baseTicket('T-0001', { status: 'done' })], []);
+  const ledger = passingLedger(snap, {
+    extraTickets: [baseTicket('T-0002')],
+    changeOrders: [{ id: 'CO-001' }],
+  });
+  const result = evaluateAutoApprove({ ledger, snapshot: snap, profile: {} });
+  assert.equal(result.ok, true);
+  assert.equal(result.conditions.every(c => c.ok), true);
+});
+
+test('evaluateAutoApprove: each condition fails alone', () => {
+  const snap = baseSnapshot([baseTicket('T-0001', { status: 'done' })], ['CO-001']);
+  const ledger = passingLedger(snap, {
+    extraTickets: [baseTicket('T-0002')],
+    changeOrders: [{ id: 'CO-001' }],
+  });
+  assert.equal(evaluateAutoApprove({ ledger, snapshot: null, profile: {} }).conditions.find(c => c.name === 'snapshot').ok, false);
+  assert.equal(evaluateAutoApprove({ ledger, snapshot: snap, profile: {} }).conditions.find(c => c.name === 'change-order').ok, false);
+
+  const snap2 = baseSnapshot([baseTicket('T-0001', { status: 'done' })], []);
+  const ledgerCancelled = {
+    tickets: [baseTicket('T-0001', { status: 'cancelled' }), baseTicket('T-0002')],
+    changeOrders: [{ id: 'CO-001' }],
+  };
+  assert.equal(evaluateAutoApprove({ ledger: ledgerCancelled, snapshot: snap2, profile: {} }).conditions.find(c => c.name === 'no-done-cancelled').ok, false);
+
+  const snap3 = baseSnapshot([baseTicket('T-0001')], []);
+  const ledgerPaid = {
+    tickets: [baseTicket('T-0001'), baseTicket('T-0002', { lane: 'anthropic:haiku' })],
+    changeOrders: [{ id: 'CO-001' }],
+  };
+  assert.equal(evaluateAutoApprove({ ledger: ledgerPaid, snapshot: snap3, profile: {} }).conditions.find(c => c.name === 'no-paid-lanes').ok, false);
+
+  const snap4 = baseSnapshot([baseTicket('T-0001')], []);
