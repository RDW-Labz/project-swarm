+      headHandle = null;
+      headKey = key;
+      headMounted = null;
+      loadCreature().then((api) => {
+        if (!api || destroyed || headKey !== key || headHandle) return;
+        try {
+          clear(hd2);
+          headHandle = api.mount(hd2, {
+            state: headWanted.state,
+            size: 290,
+            id: `orch-${key}`,
+            label: headWanted.label,
+          });
+          headMounted = headWanted.state;
+          layoutWire();
+        } catch {
+          headHandle = null;
+        }
+      });
+      return;
+    }
+    if (headHandle && headMounted !== state) {
+      headHandle.setState(state);
+      headMounted = state;
+    }
+  }
+
+  function paintCounters(items) {
+    clear(cnt);
+    for (const c of items) {
+      const cell = el(doc, 'div');
+      cell.appendChild(el(doc, 'div', 'l', c.label));
+      const v = el(doc, 'div', 'v has-tip', String(c.value));
+      v.setAttribute('tabindex', '0');
+      v.setAttribute('data-k', c.label);
+      v.setAttribute('data-tip', c.tip);
+      if (c.color) v.style.color = c.color;
+      cell.appendChild(v);
+      cnt.appendChild(cell);
+    }
+  }
+
+  function paintNow(columns, model, runs) {
+    clear(nowHost);
+    const name = model.name;
+    const lead = columns.left[0] && ['running', 'ready'].includes(columns.left[0].state) ? columns.left[0] : null;
+    if (lead) {
+      const t = lead.ticket;
+      const running = lead.state === 'running';
+      const k = el(doc, 'div', 'k');
+      k.appendChild(el(doc, 'span', null, running ? 'NOW RUNNING' : 'NEXT UP'));
+      k.appendChild(el(doc, 'span', 'cn', `1 / ${running ? columns.counts.running : columns.counts.ready}`));
+      nowHost.appendChild(k);
+      const full = String(t.title || t.id).replace(/"/g, '');
+      nowHost.appendChild(el(doc, 'div', 'p', `${name} / ${t.stage ? `${t.stage} / ` : ''}${shortTitle(full)}`));
+      nowHost.appendChild(el(doc, 'div', 't', t.id));
+      const d = el(doc, 'div', 'd', full);
+      d.setAttribute('title', full);
+      d.setAttribute('data-title', full);
+      nowHost.appendChild(d);
+    } else {
+      const k = el(doc, 'div', 'k');
+      k.appendChild(el(doc, 'span', null, 'STATUS'));
+      k.appendChild(el(doc, 'span'));
+      nowHost.appendChild(k);
+      nowHost.appendChild(el(doc, 'div', 'p', name));
+      nowHost.appendChild(el(doc, 'div', 't', model.total > 0 && model.done >= model.total ? 'All done' : 'Idle'));
+      nowHost.appendChild(el(doc, 'div', 'd', `${model.total} tickets in the ledger`));
+    }
+    const running = columns.counts.running;
+    const w = el(doc, 'div', 'd w');
+    w.appendChild(el(doc, 'em', null, 'WORKER >'));
+    w.appendChild(el(doc, 'b', null, running ? `${running} ticket${running === 1 ? '' : 's'} running now` : 'no ticket running right now'));
+    nowHost.appendChild(w);
+    renderRunLine(runLine, runs);
+    nowHost.appendChild(runLine);
+  }
+
+  let projectRef = project;
+  let firstPaint = true;
+
+  function paint(at) {
+    const p = projectRef;
+    const ledger = p?.ledger ?? { tickets: [] };
+    const model = renderCockpit(titleHost, {
+      ledger,
+      sessions: p?.sessions ?? [],
+      meta: p?.meta ?? {},
+      name: p?.name,
+      id: p?.id,
+      done: p?.done,
+      total: p?.total,
+    }, { now: at });
+    // one ordered ledger list drives both columns, the NOW card, the header, the stream count and the stack
+    const columns = cockpitLedgerRows(ledger, readyTickets, { perColumn: ROWS_PER_COLUMN });
+    const { counts } = columns;
+    const orch = model.orchestrator;
+    const allDone = model.total > 0 && model.done >= model.total;
+    const cats = cockpitCategories(ledger);
+    // the NOW RUNNING card, the highlighted row and the dotted path all follow this one ticket
+    const lead = columns.left[0];
+    activeId = lead && ['running', 'ready'].includes(lead.state) ? lead.ticket.id : null;
+
+    crumbProject.textContent = model.name;
+    paintCounters(headerCounters(p, counts));
+    metaDate.textContent = utcDate(at);
+
+    if (columns.left.length) renderTicketColumn(colL, columns.left, { side: 'L', activeId, categoryOf: cats.of });
+    else renderReadyEmptyState(colL, ledger, readyTickets);
+    renderTicketColumn(colR, columns.right, { side: 'R', activeId, categoryOf: cats.of, more: columns.more, emptyText: 'No review, blocked or finished tickets yet.' });
+    const rowsR = columns.right.length + (columns.more ? 1 : 0);
+    colL.classList.toggle?.('spread', columns.left.length >= SPREAD_MIN_ROWS);
+    colR.classList.toggle?.('spread', rowsR >= SPREAD_MIN_ROWS);
+
+    lab.setAttribute('data-orchestrator', orch.label);
+    labSub.textContent = orchestratorCaption(orch.label, allDone);
+    syncHead(orchestratorHeadState(orch.label, allDone), model.name, String(p?.id ?? model.name));
+    paintNow(columns, model, runStreamItems(p, orch));
+
+    const cards = workerCards(ledger, at, 4);
+    renderWorkerCards(wgrid, cards);
+    wCount.textContent = cards.length ? `${cards.length} LATEST · ${counts.done} DONE` : '0 DONE';
+
+    stackN.textContent = model.total > 0 ? `${model.total} TICKETS` : 'NO TICKETS';
+    stackSub.textContent = cats.field && cats.names.length
+      ? cats.names.join(' / ')
+      : 'no lane or type recorded on these tickets';
+    const tiles = [
+      ['ready', counts.ready],
+      ...(counts.running ? [['running', counts.running]] : []),
+      ['review', counts.review],
+      ['waiting', counts.blocked, 'blocked'],
+      ['to do', counts.todo, 'todo'],
+      ['done', counts.done],
+    ].map(([label, value, key]) => ({ label, value, color: TILE_COLOURS[key || label], footnote: `${value} ${label}` }));
+    const big = Math.max(...tiles.map(t => t.value));
+    for (const t of tiles) t.hi = big > 0 && t.value === big;
+    renderStackSummaryTiles(tilesHost, tiles);
+    footNote.textContent = `${counts.cancelled} cancelled, left out of the percent${counts.proposed ? ` · ${counts.proposed} proposed, not counted` : ''} · data: this project's ledger, run folders and orchestrator sessions, read at ${utcClock(at)}`;
+
+    layoutWire();
+    if (firstPaint) {
+      firstPaint = false;
+      if (doc.fonts && doc.fonts.ready && typeof doc.fonts.ready.then === 'function') {
+        doc.fonts.ready.then(() => { if (!destroyed) layoutWire(); }, () => {});
+      }
+      // the app's one glitch: the SWARM wordmark, once on arrival
+      later(() => glitch(logo), 600);
+      // stream bars grow from zero on arrival only; later polls repaint them at their width
+      later(() => shell.classList.remove('ck-intro'), 1600);
+    }
+    startMotion();
+  }
+
+  const onBackClick = () => {
+    if (typeof deps.onBack === 'function') deps.onBack();
+  };
+  backBtn.addEventListener('click', onBackClick);
+  const onLogoHover = () => glitch(logo);
+  logo.addEventListener('mouseenter', onLogoHover);
+  const onResize = () => layoutWire();
+  if (typeof win.addEventListener === 'function') win.addEventListener('resize', onResize);
+
+  try {
+    paint(nowMs(deps));
+  } catch {
+    // keep the shell and the back control usable if a panel cannot paint (partial DOM)
+  }
+
+  return {
+    update(nextProject) {
+      projectRef = nextProject;
+      paint(nowMs(deps));
+    },
+    destroy() {
+      destroyed = true;
+      for (const id of timers) clearTimer(id);
+      timers.clear();
+      if (frame != null && caf) caf(frame);
+      frame = null;
+      backBtn.removeEventListener('click', onBackClick);
+      logo.removeEventListener('mouseenter', onLogoHover);
+      if (typeof win.removeEventListener === 'function') win.removeEventListener('resize', onResize);
+      if (headHandle) headHandle.destroy();
+      headHandle = null;
+      while (host.firstChild) host.removeChild(host.firstChild);
+    },
+  };
+}
diff --git a/tools/watch-assets/cc-cockpit-orbit.js b/tools/watch-assets/cc-cockpit-orbit.js
new file mode 100644
index 00000000..2fab39dc
--- /dev/null
+++ b/tools/watch-assets/cc-cockpit-orbit.js
@@ -0,0 +1,184 @@
+// SPDX-License-Identifier: Apache-2.0
+// Cockpit orchestrator orbit: warm glow, floor shadow, the two-ring ellipse around the robot head (back half behind it, front half in
+// front of it), three orbiting dots and the thread from the ring to the highlighted ticket. Ported from the owner-approved artifact
+// (drawO / sizeO / frameO) with the same drawing and timing. The loop stops when the tab is hidden and does not run under reduced motion.
+
+const TAU = Math.PI * 2;
+const FRAME_MS = 33;
+const DOT_COLOURS = ['#2fe0a0', '#4d7cff', '#ff4d7e'];
+
+/**
+ * @param {{
+ *   back: HTMLCanvasElement, front: HTMLCanvasElement,
+ *   target?: () => (Element|null),
+ *   win?: Window, doc?: Document,
+ *   requestAnimationFrame?: (cb: (ts: number) => void) => number,
+ *   cancelAnimationFrame?: (id: number) => void,
+ *   reducedMotion?: boolean,
+ * }} opts
+ * @returns {{ resize: () => void, draw: (dt: number) => void, destroy: () => void, size: () => { width: number, height: number } }}
+ */
+export function mountOrbit(opts) {
+  const { back, front } = opts;
+  const win = opts.win || globalThis;
+  const doc = opts.doc || globalThis.document;
+  const target = typeof opts.target === 'function' ? opts.target : () => null;
+  const raf = opts.requestAnimationFrame || (typeof win.requestAnimationFrame === 'function' ? win.requestAnimationFrame.bind(win) : null);
+  const caf = opts.cancelAnimationFrame || (typeof win.cancelAnimationFrame === 'function' ? win.cancelAnimationFrame.bind(win) : null);
+  const reduce = opts.reducedMotion != null
+    ? Boolean(opts.reducedMotion)
+    : Boolean(typeof win.matchMedia === 'function' && win.matchMedia('(prefers-reduced-motion: reduce)').matches);
+  const ox = typeof back?.getContext === 'function' ? back.getContext('2d') : null;
+  const fq = typeof front?.getContext === 'function' ? front.getContext('2d') : null;
+  if (!ox || !fq) {
+    return { resize() {}, draw() {}, destroy() {}, size: () => ({ width: 0, height: 0 }) };
+  }
+
+  let OW = 0;
+  let OH = 0;
+  let ot = 0;
+  let last = 0;
+  let CN = null;
+  let rafId = null;
+  let running = false;
+  let destroyed = false;
+
+  function draw(dt) {
+    ot += dt;
+    ox.clearRect(0, 0, OW, OH);
+    fq.clearRect(0, 0, OW, OH);
+    if (!OW) return;
+    const wide = (win.innerWidth || 0) > 900;
+    const x = OW / 2;
+    const y = OH * (wide ? 0.66 : 0.58);
+    const cy = y + 42;
+    const RX = Math.min(232, OW / 2 - 8);
+    const RY = Math.max(30, RX * 0.25);
+    ox.globalCompositeOperation = 'lighter';
+    let g = ox.createRadialGradient(x, y - 10, 10, x, y - 10, 330);
+    g.addColorStop(0, 'rgba(255,160,100,.38)');
+    g.addColorStop(0.3, 'rgba(210,140,190,.22)');
+    g.addColorStop(0.6, 'rgba(169,139,255,.08)');
+    g.addColorStop(1, 'rgba(169,139,255,0)');
+    ox.fillStyle = g;
+    ox.fillRect(0, 0, OW, OH);
+    ox.globalCompositeOperation = 'source-over';
+    ox.save();
+    ox.translate(x, y + 128);
+    ox.scale(1, 0.17);
+    g = ox.createRadialGradient(0, 0, 0, 0, 0, 150);
+    g.addColorStop(0, 'rgba(0,0,0,.9)');
+    g.addColorStop(0.65, 'rgba(0,0,0,.7)');
+    g.addColorStop(1, 'rgba(0,0,0,0)');
+    ox.fillStyle = g;
+    ox.beginPath();
+    ox.arc(0, 0, 150, 0, TAU);
+    ox.fill();
+    ox.restore();
+    const ring = (c, a0, a1) => {
+      c.lineWidth = 1.4;
+      c.strokeStyle = 'rgba(200,184,255,.6)';
+      c.beginPath();
+      c.ellipse(x, cy, RX, RY, 0, a0, a1);
+      c.stroke();
+      c.lineWidth = 1;
+      c.strokeStyle = 'rgba(255,77,126,.42)';
+      c.beginPath();
+      c.ellipse(x, cy, RX * 0.82, RY * 0.78, 0, a0, a1);
+      c.stroke();
+    };
+    ring(ox, Math.PI, TAU);
+    ring(fq, 0, Math.PI);
+    for (let i = 0; i < 3; i += 1) {
+      const a = ot * (0.5 + i * 0.2) + i * 2.1;
+      const px = x + Math.cos(a) * RX * (1 - i * 0.09);
+      const py = cy + Math.sin(a) * RY * (1 - i * 0.11);
+      const c = Math.sin(a) > 0 ? fq : ox;
+      c.fillStyle = DOT_COLOURS[i];
+      c.shadowColor = c.fillStyle;
+      c.shadowBlur = 8;
+      c.beginPath();
+      c.arc(px, py, 3.4, 0, TAU);
+      c.fill();
+      c.shadowBlur = 0;
+    }
+    if (CN) {
+      const P = [[x + RX, cy], [x + RX - 6, cy - 120], [CN[0] - 90, CN[1]], CN];
+      const bz = t => [0, 1].map(k => (1 - t) ** 3 * P[0][k] + 3 * (1 - t) ** 2 * t * P[1][k] + 3 * (1 - t) * t * t * P[2][k] + t ** 3 * P[3][k]);
+      fq.strokeStyle = 'rgba(240,243,250,.92)';
+      fq.lineWidth = 1.5;
+      fq.beginPath();
+      fq.moveTo(P[0][0], P[0][1]);
+      fq.bezierCurveTo(P[1][0], P[1][1], P[2][0], P[2][1], P[3][0], P[3][1]);
+      fq.stroke();
+      fq.fillStyle = '#f4f6fb';
+      for (const t of [0, 0.3, 0.5, 0.7, 1]) {
+        const [qx, qy] = bz(t);
+        fq.beginPath();
+        fq.arc(qx, qy, t === 1 ? 4 : 3.4, 0, TAU);
+        fq.fill();
+      }
+    }
+  }
+
+  /** Re-measure the canvases and the highlighted ticket, then repaint one frame. */
+  function resize() {
+    if (destroyed) return;
+    const r = back.getBoundingClientRect();
+    OW = Math.floor(r.width);
+    OH = Math.floor(r.height);
+    back.width = OW;
+    front.width = OW;
+    back.height = OH;
+    front.height = OH;
+    const hot = target();
+    const hr = hot && hot.getBoundingClientRect();
+    CN = hr && hr.width && (win.innerWidth || 0) > 900 ? [hr.left - r.left - 2, hr.top + hr.height / 2 - r.top] : null;
+    draw(0);
+  }
+
+  function tick(ts) {
+    rafId = null;
+    if (destroyed || !running) return;
+    if (doc && doc.hidden) {
+      running = false;
+      return;
+    }
+    rafId = raf(tick);
+    if (ts - last < FRAME_MS) return;
+    const dt = Math.min(0.1, (ts - last) / 1000);
+    last = ts;
+    draw(dt);
+  }
+
+  function start() {
+    if (destroyed || running || reduce || !raf) return;
+    running = true;
+    last = 0;
+    rafId = raf(tick);
+  }
+
+  function stop() {
+    running = false;
+    if (rafId != null && caf) caf(rafId);
+    rafId = null;
+  }
+
+  const onVisibility = () => {
+    if (doc && doc.hidden) stop();
+    else start();
+  };
+  if (doc && typeof doc.addEventListener === 'function') doc.addEventListener('visibilitychange', onVisibility);
+  start();
+
+  return {
+    resize,
+    draw,
+    size: () => ({ width: OW, height: OH }),
+    destroy() {
+      destroyed = true;
+      stop();
+      if (doc && typeof doc.removeEventListener === 'function') doc.removeEventListener('visibilitychange', onVisibility);
+    },
+  };
+}
diff --git a/tools/watch-assets/cc-hive-mount.js b/tools/watch-assets/cc-hive-mount.js
new file mode 100644
index 00000000..06f65b93
--- /dev/null
+++ b/tools/watch-assets/cc-hive-mount.js
@@ -0,0 +1,1211 @@
+// SPDX-License-Identifier: Apache-2.0
+/**
+ * Command Center Hive: header counters, project cards on an ellipse around the neon ring, three panels under it.
+ * Markup and motion follow the owner-approved artifact (docs/design/reference/command-center-artifact); every number
+ * comes from the live snapshot (/api/command-center) and nothing is simulated.
+ */
+
+import { mountRobotHead, setAnimationPaused } from './robot-head.js';
+import { glitch, glitchFailure } from './cc-glitch.js';
+import { hasCompleted, isTourDisabledByQuery, startTour } from './cc-tour.js';
+
+const TAU = Math.PI * 2;
+const SVG_NS = 'http://www.w3.org/2000/svg';
+const ARC_TEXT = 'EVERY MERGE CHECKED · ONE LEDGER · MANY WORKERS · NOTHING GUESSED ·';
+// Particles per stream by colour category: busier projects spray denser streams.
+const STREAM_DENSITY = { building: 120, need: 104, blocked: 84, done: 72, idle: 64, off: 24 };
+// Bloomed 3-4 px sparks riding each stream.
+const SPARKS_PER_STREAM = 4;
+const RING_COLORS = ['#ff4d8d', '#c86bff', '#ffd6ec', '#ff3d8b'];
+
+function hexRgb(hex) {
+  const m = /^#?([0-9a-f]{6})$/i.exec(String(hex || ''));
+  const n = m ? parseInt(m[1], 16) : 0xa98bff;
+  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+}
+
+function rgba(hex, a) {
+  const [r, g, b] = hexRgb(hex);
+  return `rgba(${r},${g},${b},${a})`;
+}
+
+/**
+ * Where everything sits. Desktop: cards on an ellipse that fills the stage, the ring as large as the cards allow.
+ * Narrow screens: the canvas is a square above the cards, and each stream starts at the canvas edge.
+ */
+export function hiveGeometry(cw, ch, n, phone, cardW, cardH) {
+  const w = Math.max(40, cw);
+  const h = Math.max(40, ch);
+  const cx = w / 2;
+  const cy = h / 2;
+  const nodes = [];
+  let R;
+  if (phone) {
+    const edge = Math.min(w, h) / 2;
+    R = Math.max(24, edge * 0.62);
+    for (let i = 0; i < n; i += 1) {
+      const a = -Math.PI / 2 + (i * TAU) / Math.max(1, n);
+      nodes.push({ x: cx + Math.cos(a) * edge, y: cy + Math.sin(a) * edge, sx: cx + Math.cos(a) * edge * 0.98, sy: cy + Math.sin(a) * edge * 0.98, a, fan: 20 });
+    }
+  } else {
+    const hw = cardW / 2;
+    const hh = cardH / 2;
+    const ry = Math.max(30, cy - hh - 4);
+    const rx = Math.max(40, cx - hw - 6);
+    // As large as the cards allow (about 30% of a 1440 px screen), leaving room for the arc label.
+    let lim = ry * 0.7;
+    for (let i = 0; i < n; i += 1) {
+      const a = -Math.PI / 2 + (i * TAU) / Math.max(1, n);
+      const x = cx + Math.cos(a) * rx;
+      const y = cy + Math.sin(a) * ry;
+      const dx = Math.max(0, Math.abs(x - cx) - hw);
+      const dy = Math.max(0, Math.abs(y - cy) - hh);
+      lim = Math.min(lim, Math.hypot(dx, dy) - 30);
+      // Stream source: where the line from the card centre to the ring centre leaves the card.
+      const len = Math.hypot(cx - x, cy - y) || 1;
+      const ux = (cx - x) / len;
+      const uy = (cy - y) / len;
+      const t = Math.min(ux ? hw / Math.abs(ux) : Infinity, uy ? hh / Math.abs(uy) : Infinity);
+      nodes.push({ x, y, sx: x + ux * t, sy: y + uy * t, a, fan: Math.min(58, hw * 0.4) });
+    }
+    R = Math.max(24, lim);
+  }
+  for (const k of nodes) {
+    const b = Math.atan2(k.sy - cy, k.sx - cx);
+    k.tx = cx + Math.cos(b) * R;
+    k.ty = cy + Math.sin(b) * R;
+    const len = Math.hypot(k.tx - k.sx, k.ty - k.sy) || 1;
+    k.nx = -(k.ty - k.sy) / len;
+    k.ny = (k.tx - k.sx) / len;
+    // A slight swirl: every stream bends the same way round the ring.
+    k.qx = (k.sx + k.tx) / 2 + k.nx * len * 0.16;
+    k.qy = (k.sy + k.ty) / 2 + k.ny * len * 0.16;
+  }
+  return { w, h, cx, cy, R, coreR: R * 0.46, nodes };
+}
+
+/** Canvas layer of the Hive: dust, lane-coloured particle sprays into the ring, ring sparkles, comets and the core. */
+function createHiveRenderer(canvas, makeCanvas) {
+  const ctx = canvas && typeof canvas.getContext === 'function' ? canvas.getContext('2d') : null;
+  let geom = hiveGeometry(800, 600, 0, false, 270, 132);
+  let streams = [];
+  let streamSig = '';
+  let seedKey = '';
+  let sparkles = [];
+  let dust = [];
+  let comets = [];
+  let time = 0;
+  let speed = 1;
+  let flash = 0;
+  let flick = 0;
+  let dpr = 1;
+  let grads = null;
+  const sprites = new Map();
+
+  function sprite(col) {
+    if (sprites.has(col)) return sprites.get(col);
+    let out = null;
+    try {
+      const c = makeCanvas();
+      c.width = 32;
+      c.height = 32;
+      const x = c.getContext('2d');
+      const g = x.createRadialGradient(16, 16, 0, 16, 16, 16);
+      g.addColorStop(0, 'rgba(255,255,255,1)');
+      g.addColorStop(0.14, rgba(col, 1));
+      g.addColorStop(0.34, rgba(col, 0.5));
+      g.addColorStop(0.62, rgba(col, 0.14));
+      g.addColorStop(1, rgba(col, 0));
+      x.fillStyle = g;
+      x.fillRect(0, 0, 32, 32);
+      out = c;
+    } catch {
+      out = null;
+    }
+    sprites.set(col, out);
+    return out;
+  }
+
+  function glow(col, x, y, size, alpha) {
+    if (alpha <= 0.01) return;
+    ctx.globalAlpha = Math.min(1, alpha);
+    const s = sprite(col);
+    if (s && typeof ctx.drawImage === 'function') {
+      ctx.drawImage(s, x - size * 2, y - size * 2, size * 4, size * 4);
+    } else {
+      ctx.fillStyle = col;
+      ctx.beginPath();
+      ctx.arc(x, y, size, 0, TAU);
+      ctx.fill();
+    }
+  }
+
+  function seedStatic() {
+    const area = geom.w * geom.h;
+    dust = [];
