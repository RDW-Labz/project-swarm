+  open = [...open, normalizeHf(hf('acme/b-coder'), config, NOW), normalizeHf(hf('acme/huge-coder', { safetensors: { parameters: { BF16: 400e9 } } }), config, NOW)];
+  api = { ids: ['claude-haiku-5-5', 'claude-haiku-5-6'], skipped: null };
