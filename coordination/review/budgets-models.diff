+
+export function linkBudgetTicket(root, id, ticket) {
+  return serial(async () => {
+    const state = await readBudgetState(root);
+    if (!state.screens[id]) return;
+    state.screens[id].ticket = ticket;
+    await writeState(root, state);
+  });
