+    assert.equal(marker.childPgid, childPid);
+    assert.equal(f.read().machineConcurrency, 16);
+    wrapper.kill(signal);
+    const gone = pid => { try { process.kill(pid, 0); return false; } catch (error) { return error.code === 'ESRCH'; } };
