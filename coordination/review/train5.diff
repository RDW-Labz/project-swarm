+/* SPDX-License-Identifier: Apache-2.0 */
+/* Command Center page shell layout (full viewport, dark theme tokens aligned with shared.css). */
+:root {
+  color-scheme: dark;
+  --bg: #050508;
+  --bg-glow: #1a0a18;
+  --fg: #ececf1;
+  --muted: #9ca3af;
+  --line: #2a2a34;
+  --font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+}
+
+html,
+body {
+  height: 100%;
+  margin: 0;
+}
+
+body.cc-body.hive-body {
+  min-height: 100vh;
+  max-height: 100vh;
+  overflow: hidden;
+  background:
+    radial-gradient(900px 420px at 12% -5%, var(--bg-glow), transparent 58%),
+    radial-gradient(600px 300px at 88% 8%, rgba(30, 58, 138, .18), transparent 55%),
+    var(--bg);
+  color: var(--fg);
+  font: 14px/1.45 var(--font);
+}
+
+#command-center-root.cc-app {
+  display: flex;
+  flex-direction: column;
+  min-height: 100vh;
+  width: 100%;
+  max-width: 100%;
+  box-sizing: border-box;
+}
+
+.cc-shell-message {
+  margin: auto;
+  max-width: 28rem;
+  padding: 1.5rem 1.25rem;
+  text-align: center;
+  color: var(--muted);
+  line-height: 1.5;
+}
