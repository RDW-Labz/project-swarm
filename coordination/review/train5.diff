+  handle.destroy();
+});
+
+test('failed fetch shows an explanatory message', async () => {
+  const rt = makeRuntime();
+  rt.fetchJson = async () => {
+    throw new Error('network down');
+  };
+  await mountWithRuntime(rt);
+  const msg = rt.root.querySelector('.cc-shell-message');
