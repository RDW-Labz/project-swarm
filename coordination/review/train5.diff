+.hive-shell .hive-hbar>span:first-child,.hive-shell .hive-hbar>span.hive-fg{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.hive-shell .hive-hbar>span:last-child{text-align:right}
+.hive-shell .hive-hbar .hive-fg{color:var(--fg)}
+/* done per project: compact two-column list under the step line, in the ring colours */
+.hive-shell .hive-panel h2.hive-h-sub{margin:16px 0 10px}
+.hive-shell .hive-dpp{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px 20px;margin-top:12px}
+.hive-shell .hive-h-sub+.hive-dpp{margin-top:0}
