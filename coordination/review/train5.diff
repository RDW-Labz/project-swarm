+    const u = 1 - e;
+    return [u * u * x0 + 2 * u * e * mx + e * e * x1, u * u * y0 + 2 * u * e * my + e * e * y1];
+  }
+
+  /* static layers are drawn once (ring glow, ticks, inner disc, orbit text) and only redrawn when the size or the failure flicker changes */
+  function buildRing(hot) {
+    const c = createCanvas();
+    c.width = W;
+    c.height = H;
+    const g = c.getContext('2d');
+    const x = W / 2, y = H / 2, R = RING_R;
+    g.globalCompositeOperation = 'lighter';
+    const cg = g.createConicGradient ? g.createConicGradient(-Math.PI / 2, x, y) : null;
+    const stops = hot ? [[0, '255,182,46'], [0.5, '255,120,60'], [1, '255,182,46']] : [[0, '255,46,136'], [0.35, '255,95,168'], [0.65, '176,107,255'], [1, '255,46,136']];
+    for (const [lw, al] of [[120, 0.06], [76, 0.10], [46, 0.18], [26, 0.34], [15, 0.62], [9, 0.95]]) {
+      let st;
+      if (cg) {
+        st = g.createConicGradient(-Math.PI / 2, x, y);
+        for (const [o, col] of stops) st.addColorStop(o, `rgba(${col},${al})`);
+      } else {
+        st = g.createLinearGradient(x - R, y - R, x + R, y + R);
+        st.addColorStop(0, `rgba(${stops[0][1]},${al})`);
+        st.addColorStop(1, `rgba(176,107,255,${al})`);
+      }
+      g.strokeStyle = st; g.lineWidth = lw; g.beginPath(); g.arc(x, y, R, 0, TAU); g.stroke();
+    }
+    g.strokeStyle = 'rgba(255,170,215,.9)'; g.lineWidth = 1.4; g.beginPath(); g.arc(x, y, R, 0, TAU); g.stroke();
+    g.strokeStyle = 'rgba(255,77,126,.34)'; g.lineWidth = 1; g.setLineDash([3, 6]); g.beginPath(); g.arc(x, y, R - 18, 0, TAU); g.stroke(); g.setLineDash([]);
+    g.strokeStyle = 'rgba(169,139,255,.30)'; g.lineWidth = 1.2; g.beginPath(); g.arc(x, y, R - 36, 0, TAU); g.stroke();
+    g.beginPath(); g.arc(x, y, R + 40, 0, TAU); g.setLineDash([2, 9]); g.stroke(); g.setLineDash([]);
+    g.strokeStyle = 'rgba(169,139,255,.07)';
+    for (let i = 0; i < 24; i += 1) { const an = i / 24 * TAU; g.beginPath(); g.moveTo(x + Math.cos(an) * 142 * RK(), y + Math.sin(an) * 142 * RK()); g.lineTo(x + Math.cos(an) * (R - 36), y + Math.sin(an) * (R - 36)); g.stroke(); }
+    for (let i = 0; i < 900; i += 1) { const an = Math.random() * TAU, rr = R + (Math.random() - 0.5) * 34; g.fillStyle = Math.random() < 0.5 ? 'rgba(255,150,190,.8)' : 'rgba(190,160,255,.8)'; g.fillRect(x + Math.cos(an) * rr, y + Math.sin(an) * rr, 1.4, 1.4); }
+    g.strokeStyle = 'rgba(169,139,255,.14)';
+    for (let i = 0; i < 72; i += 1) { const an = i / 72 * TAU, l = i % 6 ? 10 : 15; g.beginPath(); g.moveTo(x + Math.cos(an) * (R + 6), y + Math.sin(an) * (R + 6)); g.lineTo(x + Math.cos(an) * (R + l), y + Math.sin(an) * (R + l)); g.stroke(); }
+    g.globalCompositeOperation = 'source-over'; g.fillStyle = '#05060b'; g.beginPath(); g.arc(x, y, 118 * RK(), 0, TAU); g.fill();
+    g.strokeStyle = 'rgba(138,107,255,.9)'; g.lineWidth = 2.4; g.beginPath(); g.arc(x, y, 120 * RK(), 0, TAU); g.stroke();
+    g.globalCompositeOperation = 'lighter'; g.strokeStyle = 'rgba(138,107,255,.25)'; g.lineWidth = 16 * RK(); g.beginPath(); g.arc(x, y, 150 * RK(), 0, TAU); g.stroke();
+    return c;
+  }
+
+  function buildText() {
+    const S = (RING_R + 60) * 2;
+    const c = createCanvas();
+    c.width = c.height = S;
+    const g = c.getContext('2d');
+    g.fillStyle = 'rgba(232,228,255,.98)';
+    g.font = '600 12px "Geist Mono", monospace';
+    const rt = RING_R + 19, step = TAU / ORBIT_TEXT.length;
+    for (let i = 0; i < ORBIT_TEXT.length; i += 1) {
+      const an = i * step - Math.PI / 2;
+      g.save(); g.translate(S / 2 + Math.cos(an) * rt, S / 2 + Math.sin(an) * rt); g.rotate(an + Math.PI / 2); g.fillText(ORBIT_TEXT[i], 0, 0); g.restore();
+    }
+    return c;
+  }
+
+  /* comet streaks inside the ring: a few white heads with tinted tails sliding from the ring toward the core disc; more of them when agents are live */
+  function comets(x, y, a, hot) {
+    const n = a >= 1 ? 4 : a > 0.5 ? 3 : 2, R = RING_R, d0 = 120 * RK();
+    cx.save(); cx.globalCompositeOperation = 'lighter';
+    for (let i = 0; i < n; i += 1) {
+      const ph = (tt * (0.09 + 0.03 * i) + i * 0.37) % 1, a0 = i * 2.4 + 0.6 + tt * 0.04, an = a0 - ph * 0.5, rr = R * 0.9 - ph * (R * 0.9 - d0 - 8);
+      const hx = x + Math.cos(an) * rr, hy = y + Math.sin(an) * rr;
+      const tl = 34 + 22 * a, tx = Math.cos(an + 0.55), ty = Math.sin(an + 0.55);
+      const ex = hx + tx * tl, ey = hy + ty * tl, al = Math.sin(ph * Math.PI);
+      const gr = cx.createLinearGradient(hx, hy, ex, ey);
+      gr.addColorStop(0, `rgba(255,255,255,${0.95 * al})`);
+      gr.addColorStop(0.25, hot ? `rgba(255,182,46,${0.5 * al})` : `rgba(190,170,255,${0.5 * al})`);
+      gr.addColorStop(1, 'rgba(120,90,255,0)');
+      cx.strokeStyle = gr; cx.lineCap = 'round'; cx.lineWidth = 3.4; cx.beginPath(); cx.moveTo(hx, hy); cx.lineTo(ex, ey); cx.stroke();
+      const hg = cx.createRadialGradient(hx, hy, 0, hx, hy, 9);
+      hg.addColorStop(0, `rgba(255,255,255,${al})`); hg.addColorStop(0.35, `rgba(220,210,255,${0.5 * al})`); hg.addColorStop(1, 'rgba(160,120,255,0)');
+      cx.fillStyle = hg; cx.beginPath(); cx.arc(hx, hy, 9, 0, TAU); cx.fill();
+    }
+    cx.restore();
+  }
+
+  /** Streams from each card: a feathered bundle of faint curves, plus (animated only) dust at the ring end. */
+  function drawStreams(x, y, still) {
+    for (const k of cards) {
+      const ax0 = x + Math.cos(k.a) * RING_R, ay0 = y + Math.sin(k.a) * RING_R;
+      if (k.cat === 'off') {
+        cx.strokeStyle = 'rgba(150,160,180,.32)'; cx.setLineDash([2, 6]); cx.lineWidth = 1; cx.beginPath(); cx.moveTo(k.x, k.y); cx.lineTo(ax0, ay0); cx.stroke(); cx.setLineDash([]);
+        continue;
+      }
+      const busyK = k.cat === 'need' || k.cat === 'building';
+      cx.strokeStyle = k.col; cx.lineWidth = 1;
+      for (let j = -5; j <= 5; j += 1) {
+        cx.globalAlpha = (busyK ? 0.38 : 0.26) * (1 - Math.abs(j) / 6.5);
+        const spread = j * (bld() ? 17 : 12);
+        const nx = Math.cos(k.a + Math.PI / 2), ny = Math.sin(k.a + Math.PI / 2);
+        cx.beginPath(); cx.moveTo(k.x + nx * j * 3, k.y + ny * j * 3);
+        cx.quadraticCurveTo((k.x + ax0) / 2 + nx * spread * 0.6, (k.y + ay0) / 2 + ny * spread * 0.6, ax0 + nx * spread * 0.55, ay0 + ny * spread * 0.55);
+        cx.stroke();
+      }
+      cx.globalAlpha = 1;
+      if (still) continue;
+      const n = busyK ? 26 : 14;
+      cx.fillStyle = k.col;
+      for (let i = 0; i < n; i += 1) {
+        const d = Math.random() * 46, sp = (Math.random() - 0.5) * 0.9;
+        cx.globalAlpha = (1 - d / 46) * (0.4 + Math.random() * 0.6);
+        cx.fillRect(ax0 - Math.cos(k.a + sp) * d, ay0 - Math.sin(k.a + sp) * d, 1.6, 1.6);
+      }
+      cx.globalAlpha = 1;
+    }
+  }
+
+  /** One frame. still = true draws the settled picture only (reduced motion, hidden tab, paused). */
+  function draw(dt, still) {
+    cx.globalCompositeOperation = 'source-over';
+    cx.clearRect(0, 0, W, H);
+    if (!W || !H) return;
+    try {
+      if (!still) tt += dt;
+      const a = act(), x = W / 2, y = H / 2, hot = fx.flick > 0;
+      const key = W + 'x' + H + (hot ? 'h' : '');
+      if (key !== ringKey) { ringL = buildRing(hot); ringKey = key; if (!txtL) txtL = buildText(); }
+      cx.globalAlpha = still ? 0.95 : 0.9 + 0.1 * Math.sin(tt * 2.1);
+      cx.drawImage(ringL, 0, 0);
+      cx.globalAlpha = 1;
+      cx.save(); cx.translate(x, y); cx.rotate(tt * 0.05); cx.drawImage(txtL, -txtL.width / 2, -txtL.height / 2); cx.restore();
+      cx.globalCompositeOperation = 'lighter';
+      if (!still && fx.pulse > 0) { cx.strokeStyle = `rgba(255,77,126,${fx.pulse * 0.6})`; cx.lineWidth = 3; cx.beginPath(); cx.arc(x, y, RING_R + (1 - fx.pulse) * 40, 0, TAU); cx.stroke(); }
+      if (!still) comets(x, y, a, hot);
+      if (!phone) drawStreams(x, y, still);
+      if (still) { cx.globalCompositeOperation = 'source-over'; return; }
+      /* inner comets: one per ten completions in the last 24 h per second (real count), plus four per live agent; they spiral from the ring into the core */
+      { const rate = (activity.done24 / 10 + activity.agents * 4 + 3) * dt; let n = Math.floor(rate) + (Math.random() < rate % 1 ? 1 : 0); while (n-- > 0 && inn.length < MAX_INNER) inn.push({ a: Math.random() * TAU, p: 0, sp: 0.5 + Math.random() * 0.6, c: INNER_COL[Math.floor(Math.random() * 5)], tw: (Math.random() < 0.5 ? -1 : 1) * (0.8 + Math.random() * 0.8) }); }
+      cx.globalCompositeOperation = 'lighter';
+      for (const q of inn) {
+        q.p += q.sp * dt * 0.9;
+        const rr = RING_R * (0.96 - 0.62 * q.p * q.p), an = q.a + q.tw * q.p * 2.2;
+        const px = x + Math.cos(an) * rr, py = y + Math.sin(an) * rr;
+        const rr2 = RING_R * (0.96 - 0.62 * Math.max(0, q.p - 0.06) ** 2), an2 = q.a + q.tw * Math.max(0, q.p - 0.06) * 2.2;
+        cx.strokeStyle = q.c; cx.globalAlpha = (1 - q.p) * 0.8; cx.lineWidth = 2; cx.beginPath(); cx.moveTo(x + Math.cos(an2) * rr2, y + Math.sin(an2) * rr2); cx.lineTo(px, py); cx.stroke();
+      }
+      cx.globalAlpha = 1;
+      for (let i = inn.length - 1; i >= 0; i -= 1) if (inn[i].p >= 1) inn.splice(i, 1);
+      cx.globalCompositeOperation = 'source-over';
+      for (const q of parts) {
+        q.p += q.sp * dt * 60;
+        const e = q.p * q.p * (3 - 2 * q.p);
+        const [px, py] = curve(q.k, e);
+        const o = q.off * (1 - e);
+        cx.strokeStyle = q.c;
+        for (let t2 = 0; t2 < 6; t2 += 1) {
+          const e0 = Math.max(0, e - (t2 + 1) * 0.022), e1 = Math.max(0, e - t2 * 0.022);
+          const [ax, ay] = curve(q.k, e0), [bx, by2] = curve(q.k, e1);
+          cx.globalAlpha = Math.min(1, q.p * 3) * (1 - t2 / 6) * 0.85; cx.lineWidth = 3.4 - t2 * 0.45;
+          cx.beginPath(); cx.moveTo(ax + o, ay); cx.lineTo(bx + o, by2); cx.stroke();
+        }
+        cx.globalAlpha = 0.9; cx.fillStyle = q.c; cx.fillRect(px + o - 2, py - 2, 4, 4);
+        cx.fillStyle = '#fff'; cx.fillRect(px + o - 0.8, py - 0.8, 1.6, 1.6); cx.globalAlpha = 1;
+        if (q.p >= 1) for (let s = 0; s < 12; s += 1) sparks.push({ x: px, y: py, vx: (Math.random() - 0.5) * 4.5, vy: (Math.random() - 0.5) * 4.5, l: 1, c: q.c });
+      }
+      for (let i = parts.length - 1; i >= 0; i -= 1) if (parts[i].p >= 1) parts.splice(i, 1);
+      for (const s of sparks) { s.x += s.vx; s.y += s.vy; s.l -= dt * 2.2; cx.fillStyle = s.c; cx.globalAlpha = Math.max(0, s.l); cx.fillRect(s.x, s.y, 2, 2); }
+      cx.globalAlpha = 1;
+      for (let i = sparks.length - 1; i >= 0; i -= 1) if (sparks[i].l <= 0) sparks.splice(i, 1);
+      if (fx.pulse > 0) fx.pulse -= dt * 1.2;
+      if (fx.flick > 0) fx.flick -= dt;
+    } catch {
+      // A canvas without the full 2D API (tests, very old browsers) draws nothing more.
+    }
+  }
+
+  /** Per-frame work of the animated loop: seed comet particles on the live cards, then draw. */
+  function frame(dt) {
+    if (!phone) {
+      for (const k of cards) {
+        if (k.cat === 'off') continue;
+        const rate = k.cat === 'need' || k.cat === 'building' ? 1.6 : k.cat === 'idle' ? 0.9 : 0.6;
+        if (Math.random() < rate * (act() + 0.5) + 0.2) spawn(k, bld() ? 5 : 2);
+      }
+    }
+    draw(dt, false);
+  }
+
+  return {
+    resize, setCards, setActivity, pulse, flick, spawn, sparkAt, frame,
+    drawStill() { draw(0, true); },
+    /** Frame interval in ms: slower while nothing is running (artifact: 50 ms calm, 33 ms live). */
+    frameMs() { return activity.agents > 0 ? 33 : 50; },
+    get size() { return { w: W, h: H, ringR: RING_R }; },
+  };
+}
diff --git a/tools/watch-assets/cc-hive.css b/tools/watch-assets/cc-hive.css
new file mode 100644
index 00000000..8aad4d0e
--- /dev/null
+++ b/tools/watch-assets/cc-hive.css
@@ -0,0 +1,265 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* Command Center Hive: rule-by-rule port of the owner-approved artifact (docs/design/reference/command-center-artifact),
+   every selector scoped under .hive-body or .hive-shell. Artifact class names gained a hive- prefix so nothing here can
+   collide with swarm-ui.css or the Cockpit (artifact .card is .hive-card, .top is .hive-top, .stage is .hive-stage, ...).
+   Shared tokens and fonts come from /assets/cc-theme.css. */
+
+/* tokens other Command Center pages still read (the artifact tokens live in cc-theme.css) */
+.hive-body{
+  --bg-glow: #1a0a18;
+  --card: #12121a;
+  --card-2: #181822;
+  --line-soft: #22222d;
+  --faint: #7f8797;
+  --accent: #34d399;
+  --accent-ink: #04130d;
+  --ok: #34d399;
+  --warn: #fbbf24;
+  --bad: #fb7185;
+  --info: #60a5fa;
+  --lav: #a78bfa;
+  --haiku: #34d399;
+  --sonnet: #60a5fa;
+  --opus: #fbbf24;
+  --codex: #f472b6;
+  --cursor: #a3e635;
+  --gpu: #fb923c;
+  --claude: #94a3b8;
+  --other: #94a3b8;
+  --r-sm: 10px;
+  --r: 16px;
+  --r-lg: 22px;
+  --pill: 999px;
+  --font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  --font-script: ui-serif, Georgia, "Times New Roman", Times, serif;
+  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+  --ease: cubic-bezier(.2, .7, .2, 1);
+  --dur-fast: 120ms;
+  --dur: 220ms;
+  --dur-slow: 420ms;
+}
+
+/* single dark look by design (neon HUD); all colours explicit so it reads on any host background */
+.hive-body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--font-body);font-size:15px;line-height:1.4;overflow-x:hidden;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-bottom:30px}
+.hive-body *,.hive-body *::before,.hive-body *::after{box-sizing:border-box}
+.hive-body :focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
+.hive-body #command-center-root:has(> .hive-shell){max-width:none;margin:0;padding:0;background:none}
+.hive-body:has(.hive-shell) .cc-tour-fab{display:none}
+.hive-body .cc-shell-message{max-width:720px;margin:40px auto;padding:14px 16px;border:1px solid var(--line);border-radius:10px;background:var(--panel);color:var(--muted);font-family:var(--font-mono);font-size:13px}
+
+.hive-shell{max-width:1320px;margin:0 auto}
+.hive-shell .hive-mono{font-family:var(--font-mono);font-variant-numeric:tabular-nums}
+.hive-shell button{font:inherit;font-size:13px;background:var(--panel2);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:6px 10px;cursor:pointer}
+.hive-shell button:hover{border-color:var(--blue)}
+.hive-shell .hive-hint{color:var(--muted);font-size:12px}
+.hive-shell .hive-muted{font-family:var(--font-mono);font-size:11px;color:var(--dim);margin:0}
+
+/* header: one line like the target (logo, tagline, counters, LIVE); the tour link and a small "···" views menu close it */
+.hive-shell .hive-top{position:relative;display:flex;flex-wrap:wrap;align-items:center;gap:10px 22px;padding:18px 0 20px;border-bottom:1px solid var(--line)}
+.hive-shell .hive-logo{font-family:var(--font-display);font-style:italic;font-weight:900;font-size:44px;letter-spacing:-.01em;filter:drop-shadow(0 0 14px rgba(255,77,126,.35));line-height:1;background:linear-gradient(90deg,#ff4d7e,#a98bff);-webkit-background-clip:text;background-clip:text;color:transparent}
+.hive-shell .hive-tag{font-family:var(--font-mono);font-size:12.5px;color:#c9d1e3;line-height:1.75;white-space:nowrap}
+.hive-shell .hive-cnt{display:flex;gap:26px;margin-left:auto}
+.hive-shell .hive-cnt>div{text-align:center}
+.hive-shell .hive-cnt .l{font-family:var(--font-mono);font-size:10px;letter-spacing:.2em;color:var(--dim);text-transform:uppercase}
+.hive-shell .hive-cnt .v{font-family:var(--font-mono);font-size:24px;font-weight:500}
+.hive-shell .hive-live{position:relative;display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.2em}
+.hive-shell .hive-live i{width:8px;height:8px;border-radius:50%;background:var(--red);box-shadow:0 0 10px var(--red);animation:hive-beat 1.8s ease-in-out infinite}
+@keyframes hive-beat{0%,100%{opacity:1}50%{opacity:.35}}
+.hive-shell .hive-cnt .v.is-bump{animation:hive-bump .9s ease-out 1}
+@keyframes hive-bump{0%{text-shadow:0 0 0 transparent}30%{text-shadow:0 0 14px currentColor}100%{text-shadow:0 0 0 transparent}}
+.hive-shell .hive-end{position:relative;display:flex;align-items:center;gap:16px}
+.hive-shell .hive-link{background:none;border:0;border-radius:4px;padding:0 2px;font-family:var(--font-mono);font-size:10px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;line-height:20px;color:var(--dim);cursor:pointer}
+.hive-shell .hive-link:hover,.hive-shell .hive-link:focus-visible{color:var(--fg)}
+.hive-shell .hive-menu{position:relative}
+.hive-shell .hive-menu-btn{display:block;list-style:none;cursor:pointer;user-select:none;padding:0 7px;border:1px solid var(--line);border-radius:6px;font-family:var(--font-mono);font-size:13px;font-weight:700;letter-spacing:.08em;line-height:20px;color:var(--muted)}
+.hive-shell .hive-menu-btn::-webkit-details-marker{display:none}
+.hive-shell .hive-menu-btn::marker{content:""}
+.hive-shell .hive-menu-btn:hover,.hive-shell .hive-menu[open] .hive-menu-btn{color:var(--fg);border-color:color-mix(in srgb,var(--red) 60%,var(--line))}
+.hive-shell .hive-nav{position:absolute;right:0;top:calc(100% + 8px);z-index:60;display:flex;flex-direction:column;align-items:stretch;min-width:200px;padding:6px;background:var(--panel2);border:1px solid var(--line);border-radius:10px;box-shadow:0 14px 34px rgba(0,0,0,.6);animation:hive-drop .16s ease-out both}
+@keyframes hive-drop{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}
+.hive-shell .hive-tab,.hive-shell .hive-tabbtn{display:flex;align-items:center;justify-content:space-between;width:100%;font-family:var(--font-mono);font-size:10px;font-weight:500;letter-spacing:.2em;text-transform:uppercase;line-height:28px;text-align:left;background:none;border:0;border-radius:6px;padding:0 10px;color:var(--muted);text-decoration:none;cursor:pointer;white-space:nowrap}
+.hive-shell .hive-tab:hover,.hive-shell .hive-tabbtn:hover,.hive-shell .hive-tab:focus-visible,.hive-shell .hive-tabbtn:focus-visible{color:var(--fg);background:rgba(255,255,255,.04)}
+.hive-shell .hive-tab[aria-current=page]{color:var(--red);text-shadow:0 0 10px rgba(255,77,126,.55)}
+.hive-shell .hive-tabbtn .hive-hint{font-size:10px;letter-spacing:.1em;color:#5d6780;margin-left:10px}
+
+/* HIVE stage: sized from the viewport so the ring, every card and the legend row fit the first screen */
+.hive-shell .hive-stage{--hs:1;position:relative;height:clamp(560px,calc(100vh - 120px),800px);max-width:1320px;margin:0 auto}
+.hive-shell .hive-stage canvas{position:absolute;z-index:2;inset:0;width:100%;height:100%;display:block;pointer-events:none}
+.hive-shell .hive-card{position:absolute;z-index:3;width:270px;transform:translate(-50%,-50%) scale(var(--hs));background:#07080f;border:2px solid var(--c);border-radius:6px;box-shadow:0 0 0 1px color-mix(in srgb,var(--c) 70%,transparent),0 0 10px 1px color-mix(in srgb,var(--c) 85%,transparent),0 0 30px 4px color-mix(in srgb,var(--c) 42%,transparent),0 0 64px 12px color-mix(in srgb,var(--c) 14%,transparent),inset 0 0 22px -12px color-mix(in srgb,var(--c) 55%,transparent);cursor:pointer;transition:transform .2s var(--ease),box-shadow .2s}
+.hive-shell .hive-card:hover,.hive-shell .hive-card:focus-visible{transform:translate(-50%,calc(-50% - 3px)) scale(var(--hs));box-shadow:0 0 0 1px var(--c),0 0 14px 2px var(--c),0 0 40px 8px color-mix(in srgb,var(--c) 50%,transparent),inset 0 0 22px -10px var(--c)}
+.hive-shell .hive-card-hd{display:flex;align-items:center;gap:8px;padding:5px 10px;background:var(--c);color:#05060b;font-family:var(--font-mono);font-weight:700;font-size:12px;line-height:15px;border-radius:3px 3px 0 0}
+.hive-shell .hive-card-hd .name{flex:1;min-width:0;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.hive-shell .hive-card-hd .k{font-weight:500;opacity:.62;margin-right:7px}
+.hive-shell .hive-card-hd .t{flex:none;margin-left:auto;font-size:9px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap;opacity:.88}
+.hive-shell .hive-card-bd{padding:7px 11px 8px;font-family:var(--font-mono);font-size:11px;line-height:15px;display:grid;gap:2px}
+.hive-shell .hive-card .r{display:flex;align-items:center;justify-content:space-between;gap:10px}
+.hive-shell .hive-card .r>span:first-child{color:var(--dim)}
+.hive-shell .hive-card .r>.val{order:2;color:#f1f4fa;text-align:right}
+.hive-shell .hive-card .r>.pills{order:1;display:flex;gap:4px;margin-right:auto}
+.hive-shell .hive-pill{display:inline-block;padding:0 6px;border-radius:999px;font-size:8.5px;line-height:13px;letter-spacing:.12em;text-transform:uppercase;white-space:nowrap;color:var(--pc);border:1px solid color-mix(in srgb,var(--pc) 70%,transparent);background:color-mix(in srgb,var(--pc) 14%,transparent);animation:hive-chip 2.4s ease-in-out infinite}
+.hive-shell .hive-pill--need{--pc:var(--red)}
+.hive-shell .hive-pill--live{--pc:var(--green);animation-delay:-1.2s}
+@keyframes hive-chip{0%,100%{box-shadow:0 0 0 0 transparent}50%{box-shadow:0 0 9px 0 color-mix(in srgb,var(--pc) 55%,transparent)}}
+.hive-shell .hive-card .pb{display:flex;align-items:center;gap:10px;margin-top:4px}
+.hive-shell .hive-card .pb b{color:var(--c);font-weight:500;flex:none}
+.hive-shell .hive-card .pb i{position:relative;flex:1;height:5px;border-radius:3px;background:#161b29;overflow:hidden}
+.hive-shell .hive-card .pb i u{display:block;height:100%;border-radius:3px;background:var(--c);box-shadow:0 0 8px var(--c);transform-origin:left}
+.hive-shell .hive-card[data-status=building] .pb i::after{content:"";position:absolute;inset:0;width:30%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);animation:hive-scan 2.6s linear infinite}
+@keyframes hive-scan{0%{transform:translateX(-100%)}100%{transform:translateX(340%)}}
+.hive-shell .hive-card .pb em{font-style:normal;color:#f1f4fa;flex:none}
+.hive-shell .hive-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
+
+/* the ring: a thick conic pink-violet band, two thinner inner rings and a dotted outer ring under a stacked bloom
+   (canvas adds the spokes, the hot line, sparkles and the streams on top) */
+.hive-shell .hive-ringfx{position:absolute;z-index:1;left:50%;top:50%;width:440px;height:440px;transform:translate(-50%,-50%);pointer-events:none;filter:drop-shadow(0 0 24px rgba(255,61,139,.85)) drop-shadow(0 0 60px rgba(176,77,255,.55))}
+.hive-shell .hive-ringfx i{position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 200deg,#ff3d8b,#c86bff,#ff3d8b,#ff6aa8,#c86bff,#ff3d8b);-webkit-mask:radial-gradient(closest-side,transparent calc(100% - 9px),#000 calc(100% - 8px),#000 calc(100% - 1px),transparent 100%);mask:radial-gradient(closest-side,transparent calc(100% - 9px),#000 calc(100% - 8px),#000 calc(100% - 1px),transparent 100%);animation:hive-spin 24s linear infinite}
+.hive-shell .hive-ringfx::before{content:"";position:absolute;inset:15px;border-radius:50%;border:2px solid rgba(255,96,170,.6);box-shadow:0 0 10px rgba(255,61,139,.5),inset 0 0 12px rgba(255,61,139,.25)}
+.hive-shell .hive-ringfx::after{content:"";position:absolute;inset:28px;border-radius:50%;border:1px solid rgba(190,120,255,.5);box-shadow:0 0 8px rgba(176,77,255,.35)}
+.hive-shell .hive-ringfx b{position:absolute;inset:-7px;border-radius:50%;border:1px dotted rgba(255,150,205,.7);animation:hive-spin 90s linear infinite reverse}
+@keyframes hive-spin{to{transform:rotate(360deg)}}
+.hive-shell .hive-arc{position:absolute;z-index:2;left:50%;top:50%;width:440px;height:440px;transform:translate(-50%,-50%);overflow:visible;pointer-events:none;animation:hive-orbit 60s linear infinite}
+.hive-shell .hive-arc text{font-family:var(--font-mono);font-size:11px;font-weight:500;letter-spacing:.45em;fill:rgba(255,255,255,.75)}
+@keyframes hive-orbit{from{transform:translate(-50%,-50%) rotate(0)}to{transform:translate(-50%,-50%) rotate(360deg)}}
+.hive-shell .hive-core{--cr:80;position:absolute;z-index:2;left:50%;top:50%;transform:translate(-50%,-50%);width:calc(var(--cr) * 1.8px);text-align:center;pointer-events:none}
+.hive-shell .hive-core .a{font-family:var(--font-mono);font-size:max(7px,calc(var(--cr) * .11px));letter-spacing:.3em;color:#8d99b3;margin-bottom:2px}
+.hive-shell .hive-core .n{font-family:var(--font-display);font-style:italic;font-weight:800;font-size:calc(var(--cr) * .5px);line-height:1;margin:2px 0 4px;color:#f4f6fb;text-shadow:0 0 22px rgba(176,107,255,.6)}
+.hive-shell .hive-core .s{font-family:var(--font-mono);font-size:max(9px,calc(var(--cr) * .15px));color:var(--violet)}
+.hive-shell .hive-core .x{font-family:var(--font-mono);font-size:max(8px,calc(var(--cr) * .12px));line-height:1.35;color:var(--dim);margin-top:2px;text-wrap:balance}
+
+/* lane legend + tagline row */
+.hive-shell .hive-legend{display:flex;flex-wrap:wrap;gap:8px 22px;font-family:var(--font-mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;padding:8px 4px 6px;align-items:center}
+.hive-shell .hive-legend span i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:8px;box-shadow:0 0 8px currentColor}
+.hive-shell .hive-legend .tl{margin-left:auto;font-family:var(--font-display);font-style:italic;font-weight:700;font-size:23px;line-height:1.1;text-transform:none;letter-spacing:-.01em;color:var(--fg)}
+.hive-shell .hive-legend .tl u{text-decoration:none;color:var(--fg)}
+.hive-shell .hive-legend .tl u:first-child{color:var(--violet)}
+.hive-shell .hive-legend .tl b{font-weight:700;color:var(--red)}
+
+/* speech-bubble badges over robot heads (drawn in CSS) */
+.hive-shell .hive-bub{position:absolute;top:-8px;right:-10px;z-index:2;min-width:15px;height:17px;padding:0 3px;border-radius:5px 5px 5px 1px;background:#f4f6fb;color:#05060b;font:700 11px/17px var(--font-mono);text-align:center;pointer-events:none}
+.hive-shell .hive-bub--excl{color:var(--red)}
+.hive-shell .hive-bub--stars{color:var(--amber)}
+.hive-shell .hive-bub--cross{color:var(--red)}
+.hive-shell .hive-bot--mono{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:5px;background:rgba(5,6,11,.55);color:#e8f2ff;font:600 12px/1 var(--font-mono)}
+
+/* bottom panels */
+.hive-shell .hive-panels,.hive-shell .hive-panels *{font-family:var(--font-mono)}
+.hive-shell .hive-panels .hive-hint{font-size:11px}
+.hive-shell .hive-panels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));align-items:stretch;background:var(--panel);border:1px solid var(--line);border-radius:14px;margin-top:10px}
+/* each column is a flex stack whose last block (.hive-push) sits on the shared bottom line */
+.hive-shell .hive-panel{display:flex;flex-direction:column;padding:24px 26px 22px;min-width:0;border-right:1px solid var(--line)}
+.hive-shell .hive-panel:last-child{border:0}
+.hive-shell .hive-push{margin-top:auto;padding-top:14px}
+.hive-shell .hive-panel h2{font-size:11px;letter-spacing:.3em;color:var(--muted);font-weight:500;margin:0 0 16px;text-transform:uppercase}
+.hive-shell .hive-panel h2.hive-h-gap{margin-top:16px;padding-top:16px;border-top:1px solid var(--line)}
+.hive-shell .hive-slog{display:grid;gap:5px;font-size:11px;line-height:1.35}
+.hive-shell .hive-slog-row{display:grid;grid-template-columns:52px minmax(0,1fr);gap:8px}
+.hive-shell .hive-slog-row>span{display:block;overflow-wrap:anywhere;color:var(--muted)}
+.hive-shell .hive-slog b{font-weight:500}
+.hive-shell .hive-slog-row span.hive-fg{color:var(--fg)}
+.hive-shell .hive-slog-row span.hive-dim{color:var(--dim)}
+/* mini bar chart under the command line: thin lane-coloured bars like the target's "forks per second" */
+.hive-shell .hive-bars{display:flex;align-items:flex-end;justify-content:space-between;gap:3px;height:70px;margin-top:10px}
+.hive-shell .hive-bars:has(.hive-muted){height:auto;align-items:center}
+.hive-shell .hive-bars i{flex:1 1 0;max-width:6px;border-radius:1px 1px 0 0;min-height:2px;transform-origin:bottom;animation:hive-rise .7s var(--ease) both}
+.hive-shell .hive-bars[data-mode=status] i:nth-child(4n+1):not(:first-child){margin-left:5px}
+@keyframes hive-rise{from{transform:scaleY(0)}to{transform:none}}
+.hive-shell .hive-cap{font-size:11px;color:var(--dim);margin-top:8px}
+.hive-shell .hive-cap--row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:2px 12px}
+.hive-shell .hive-cap--row .hive-muted{font-size:10px;opacity:.8}
+.hive-shell .hive-cap--cmd{margin-top:0;font-size:12px;color:var(--muted)}
+.hive-shell .hive-cap--cmd .p{color:var(--dim)}
+.hive-shell .hive-cap--cmd b{font-weight:500;color:var(--fg)}
+.hive-shell .hive-panels .hive-big{font-family:var(--font-display);font-style:italic;font-weight:800;font-size:60px;line-height:1;color:var(--red);text-shadow:0 0 22px rgba(255,77,126,.5);margin-top:4px}
+.hive-shell .hive-big small{font-family:var(--font-mono);font-style:normal;font-weight:400;font-size:14px;color:var(--muted);text-shadow:none;margin-left:12px}
+.hive-shell .hive-hint--machines{margin:10px 0 16px;overflow-wrap:anywhere}
