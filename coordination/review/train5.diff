+    commandList: [],
+    contextCommands: () => [],
+    ...overrides,
+  });
+  await srv.listen();
+  const port = Number(new URL(srv.url).port);
+  return {
+    srv,
+    assetDir,
+    port,
+    dispose: async () => {
+      try {
