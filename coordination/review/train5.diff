+
+/* footer, tooltips, toast */
+.hive-shell .hive-foot{display:flex;flex-wrap:wrap;gap:4px 14px;align-items:baseline;margin-top:12px;padding:0 2px;font-family:var(--font-mono);font-size:10px;color:#6f7b94}
