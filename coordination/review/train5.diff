+.hive-shell .hive-dpp .hive-hbar>span:first-child{color:var(--muted)}
+.hive-shell .hive-dpp .hive-muted{grid-column:1/-1}
+.hive-shell .hive-who .hive-hbar{margin:10px 0}
+.hive-shell .hive-who .hive-cap{margin-top:4px}
+.hive-shell .hive-who>.hive-muted{font-size:10px;margin-top:4px;opacity:.8}
+.hive-shell .hive-lh{position:relative;display:flex}
+.hive-shell .hive-kv{display:flex;justify-content:space-between;gap:12px;font-size:12px;color:var(--muted);margin:7px 0}
+.hive-shell .hive-kv b{font-weight:500;text-align:right}
+.hive-shell .hive-kvs .hive-kv:last-child{margin-bottom:0}
+/* step line: pink glowing steps with a bright segment running along them */
