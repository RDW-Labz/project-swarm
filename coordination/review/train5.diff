@@ -0,0 +1,182 @@
+// SPDX-License-Identifier: Apache-2.0
+import './_isolate-config.mjs';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  trackBrowser,
+  descendantPids,
+  closeBrowserFully,
+  assertNoLeftoverBrowser,
+} from './browser/browser-cleanup.mjs';
+
+test('trackBrowser records pid from a BrowserServer', () => {
+  const server = {
+    process: () => ({ pid: 4242 }),
+  };
+  const tracked = trackBrowser(server);
+  assert.equal(tracked.pid, 4242);
+  assert.equal(tracked.closed, false);
+});
+
+test('trackBrowser accepts { server, browser } and uses the server pid', () => {
+  const server = {
+    process: () => ({ pid: 5150 }),
+  };
+  const browser = { close: async () => {} };
+  const tracked = trackBrowser({ server, browser });
+  assert.equal(tracked.pid, 5150);
+});
+
+test('trackBrowser rejects a plain object without server.process()', () => {
+  assert.throws(
+    () => trackBrowser({ close: async () => {} }),
+    (err) => {
+      assert.match(err.message, /BrowserServer|server\.process/i);
+      return true;
+    },
+  );
+});
+
+test('descendantPids walks a multi-level tree and ignores unrelated rows', () => {
+  const list = [
+    { pid: 1, ppid: 0 },
+    { pid: 100, ppid: 1 },
+    { pid: 101, ppid: 100 },
+    { pid: 102, ppid: 101 },
+    { pid: 200, ppid: 1 },
+    { pid: 201, ppid: 200 },
+    { pid: 999, ppid: 50 },
+  ];
+  const got = descendantPids(100, list).sort((a, b) => a - b);
+  assert.deepEqual(got, [101, 102]);
+});
+
+test('closeBrowserFully closes page, context, and browser even when the first throws', async () => {
+  const calls = [];
+  const page = {
+    close: async () => {
+      calls.push('page');
+      throw new Error('page close failed');
+    },
+  };
+  const context = {
+    close: async () => {
+      calls.push('context');
+    },
+  };
+  const browser = {
+    close: async () => {
+      calls.push('browser');
+    },
+  };
+  const tracked = { pid: 5000 };
+  await closeBrowserFully({
+    pages: [page],
+    context,
+    browser,
+    tracked,
+    listProcesses: () => [],
+    isAlive: () => false,
+    wait: async () => {},
+    killProcess: () => {},
+  });
+  assert.deepEqual(calls, ['page', 'context', 'browser']);
+});
+
+test('closeBrowserFully escalates SIGTERM to SIGKILL on the group when root stays alive', async () => {
+  const kills = [];
+  const tracked = { pid: 7000 };
+  const listProcesses = () => [{ pid: 7000, ppid: 1, command: 'chromium' }];
+
+  await closeBrowserFully({
+    browser: { close: async () => {} },
+    tracked,
+    listProcesses,
+    isAlive: (pid) => pid === 7000,
+    wait: async () => {},
+    killProcess: (pid, signal, opts) => {
+      kills.push({ pid, signal, group: Boolean(opts?.group) });
+    },
+  });
+
+  assert.ok(kills.some((k) => k.pid === 7000 && k.signal === 'SIGTERM' && k.group));
+  assert.ok(kills.some((k) => k.pid === 7000 && k.signal === 'SIGKILL' && k.group));
+});
+
+test('closeBrowserFully never kills pid 0, 1, negatives, or pids outside the tracked tree', async () => {
+  const kills = [];
+  const tracked = { pid: 8000 };
+  const listProcesses = () => [
+    { pid: 0, ppid: 0, command: 'kernel' },
+    { pid: 1, ppid: 0, command: 'init' },
+    { pid: 8000, ppid: 1, command: 'browser-root' },
+    { pid: 8001, ppid: 8000, command: 'browser-child' },
+    { pid: 9000, ppid: 1, command: 'other-app' },
+  ];
+
+  await closeBrowserFully({
+    browser: { close: async () => {} },
+    tracked,
+    listProcesses,
+    isAlive: (pid) => [8000, 8001, 9000, 0, 1, -5].includes(pid),
+    wait: async () => {},
+    killProcess: (pid, signal, opts) => {
+      kills.push({ pid, signal, group: Boolean(opts?.group) });
+    },
+  });
+
+  const killedPids = kills.map((k) => k.pid);
+  assert.ok(!killedPids.includes(0));
+  assert.ok(!killedPids.includes(1));
+  assert.ok(!killedPids.some((p) => p < 0));
+  assert.ok(!killedPids.includes(9000));
+  assert.ok(killedPids.includes(8000));
+  assert.ok(killedPids.includes(8001));
+});
+
+test('assertNoLeftoverBrowser throws naming leftover pid and passes when none alive', () => {
+  const listProcesses = () => [
+    { pid: 6000, ppid: 1, command: 'parent-browser' },
+    { pid: 6001, ppid: 6000, command: 'child-renderer' },
+  ];
+  const tracked = { pid: 6000 };
+
+  assert.throws(
+    () =>
+      assertNoLeftoverBrowser(tracked, {
+        listProcesses,
+        isAlive: (pid) => pid === 6001,
+      }),
+    (err) => {
+      assert.match(err.message, /6001/);
+      assert.match(err.message, /child-renderer/);
+      return true;
+    },
+  );
+
+  assertNoLeftoverBrowser(tracked, {
+    listProcesses,
+    isAlive: () => false,
+  });
+});
+
+test('closeBrowserFully is safe to call twice', async () => {
+  let closeCount = 0;
+  const tracked = { pid: 7500 };
+  const browser = {
+    close: async () => {
+      closeCount += 1;
+    },
+  };
+  const deps = {
+    browser,
+    tracked,
+    listProcesses: () => [],
+    isAlive: () => false,
+    wait: async () => {},
+    killProcess: () => {},
+  };
+  await closeBrowserFully(deps);
+  await closeBrowserFully(deps);
+  assert.equal(closeCount, 2);
+});
diff --git a/tests/browser/browser-cleanup.mjs b/tests/browser/browser-cleanup.mjs
new file mode 100644
index 00000000..d97c1a00
--- /dev/null
+++ b/tests/browser/browser-cleanup.mjs
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: Apache-2.0
+import { execFileSync } from 'node:child_process';
+import process from 'node:process';
+
+function defaultWait(ms) {
+  return new Promise((resolve) => {
+    setTimeout(resolve, ms);
+  });
+}
+
+function defaultListProcesses() {
+  const out = execFileSync('ps', ['-axo', 'pid=,ppid=,command='], { encoding: 'utf8' });
+  const rows = [];
+  for (const line of out.split('\n')) {
+    const trimmed = line.trim();
+    if (!trimmed) continue;
+    const match = trimmed.match(/^(\d+)\s+(\d+)\s+(.*)$/);
+    if (!match) continue;
+    rows.push({
+      pid: Number(match[1]),
+      ppid: Number(match[2]),
+      command: match[3],
+    });
+  }
+  return rows;
+}
+
+function defaultIsAlive(pid, { listProcesses = defaultListProcesses } = {}) {
+  if (!isKillablePid(pid)) return false;
+  const list = listProcesses();
+  return list.some((row) => row.pid === pid);
+}
+
+function defaultKillProcess(pid, signal, { group = false } = {}) {
+  if (!isKillablePid(pid)) return;
+  const target = group ? -pid : pid;
+  process.kill(target, signal);
+}
+
+function isKillablePid(pid) {
+  return Number.isInteger(pid) && pid > 1;
+}
+
+/**
+ * @param {import('playwright').BrowserServer | { server: import('playwright').BrowserServer, browser?: import('playwright').Browser }} target
+ */
+export function trackBrowser(target) {
+  let server = target;
+  if (target && typeof target === 'object' && target.server && typeof target.server.process === 'function') {
+    server = target.server;
+  }
+  if (!server || typeof server.process !== 'function') {
+    throw new Error('trackBrowser: expected a BrowserServer or { server, browser } with server.process()');
+  }
+  const proc = server.process();
+  const pid = proc?.pid;
+  if (!Number.isInteger(pid) || pid <= 0) {
+    throw new Error('trackBrowser: server.process() did not return a pid');
+  }
+  return { pid, closed: false };
+}
+
+/**
+ * @param {number} rootPid
+ * @param {{ pid: number, ppid: number }[]} processList
+ * @returns {number[]}
+ */
+export function descendantPids(rootPid, processList) {
+  if (!Number.isInteger(rootPid) || rootPid <= 0) return [];
+  const children = new Map();
+  for (const row of processList) {
+    if (!Number.isInteger(row.pid) || !Number.isInteger(row.ppid)) continue;
+    if (!children.has(row.ppid)) children.set(row.ppid, []);
+    children.get(row.ppid).push(row.pid);
+  }
+  const out = [];
+  const stack = [...(children.get(rootPid) ?? [])];
+  const seen = new Set();
+  while (stack.length) {
+    const pid = stack.pop();
+    if (seen.has(pid)) continue;
+    seen.add(pid);
+    out.push(pid);
+    const kids = children.get(pid);
+    if (kids) stack.push(...kids);
+  }
+  return out;
+}
+
+function trackedTreePids(tracked, listProcesses) {
+  if (!tracked?.pid) return [];
+  const list = listProcesses();
+  const desc = descendantPids(tracked.pid, list);
+  const aliveRoot = list.some((row) => row.pid === tracked.pid);
+  return aliveRoot ? [tracked.pid, ...desc] : desc;
+}
+
+function pidsStillAlive(pids, isAlive, deps) {
+  const alive = [];
+  for (const pid of pids) {
+    if (isKillablePid(pid) && isAlive(pid, deps)) alive.push(pid);
+  }
+  return alive;
+}
+
+async function waitForPidsExit(pids, timeoutMs, { isAlive, wait, ...deps }) {
+  const deadline = Date.now() + timeoutMs;
+  while (Date.now() < deadline) {
+    const alive = pidsStillAlive(pids, isAlive, deps);
+    if (!alive.length) return;
+    await wait(50);
+  }
+}
+
+/**
+ * @param {{
+ *   browser?: import('playwright').Browser,
+ *   context?: import('playwright').BrowserContext,
+ *   pages?: import('playwright').Page[],
+ *   tracked?: { pid: number, closed?: boolean },
+ *   listProcesses?: typeof defaultListProcesses,
+ *   killProcess?: typeof defaultKillProcess,
+ *   isAlive?: typeof defaultIsAlive,
+ *   wait?: typeof defaultWait,
+ * }} opts
+ */
+export async function closeBrowserFully(opts = {}) {
+  const listProcesses = opts.listProcesses ?? defaultListProcesses;
+  const killProcess = opts.killProcess ?? defaultKillProcess;
+  const isAlive = opts.isAlive ?? defaultIsAlive;
+  const wait = opts.wait ?? defaultWait;
+  const deps = { listProcesses, killProcess, isAlive, wait };
+
+  const pages = Array.isArray(opts.pages) ? opts.pages : [];
+  for (const page of pages) {
+    try {
+      if (page) await page.close();
+    } catch {
+      /* continue closing */
+    }
+  }
+
+  try {
+    if (opts.context) await opts.context.close();
+  } catch {
+    /* continue */
+  }
+
+  try {
+    if (opts.browser) await opts.browser.close();
+  } catch {
+    /* continue */
+  }
+
+  const tracked = opts.tracked;
+  if (!tracked?.pid || tracked.closed) return;
+  tracked.closed = true;
+
+  const rootPid = tracked.pid;
+  const treePids = () => {
+    const desc = descendantPids(rootPid, listProcesses());
+    return [rootPid, ...desc];
+  };
+
+  await waitForPidsExit(treePids(), 3000, deps);
+
+  let alive = pidsStillAlive(treePids(), isAlive, deps);
+  if (alive.length && isKillablePid(rootPid) && isAlive(rootPid, deps)) {
+    try {
+      killProcess(rootPid, 'SIGTERM', { group: true });
+    } catch {
+      /* may already be gone */
+    }
+  }
+
+  await wait(1000);
+
+  const afterTerm = treePids();
+  const stillOnGroup = pidsStillAlive(
+    afterTerm.filter((pid) => pid === rootPid),
+    isAlive,
+    deps,
+  );
+  if (stillOnGroup.length && isKillablePid(rootPid)) {
+    try {
+      killProcess(rootPid, 'SIGKILL', { group: true });
+    } catch {
+      /* continue */
+    }
+  }
+
+  await wait(50);
+
+  const descendants = descendantPids(rootPid, listProcesses());
+  for (const pid of descendants) {
+    if (!isKillablePid(pid)) continue;
+    if (!isAlive(pid, deps)) continue;
+    try {
+      killProcess(pid, 'SIGKILL', { group: false });
+    } catch {
+      /* continue */
+    }
+  }
+}
+
+/**
+ * @param {{ pid: number }} tracked
+ * @param {{ listProcesses?: typeof defaultListProcesses, isAlive?: typeof defaultIsAlive }} [injected]
+ */
+export function assertNoLeftoverBrowser(tracked, injected = {}) {
+  const listProcesses = injected.listProcesses ?? defaultListProcesses;
+  const isAlive = injected.isAlive ?? defaultIsAlive;
+  const deps = { listProcesses, ...injected };
+
+  if (!tracked?.pid) return;
+
+  const list = listProcesses();
+  const desc = descendantPids(tracked.pid, list);
+  const leftovers = [];
+  const rootAlive = isKillablePid(tracked.pid) && isAlive(tracked.pid, deps);
+  if (rootAlive) {
+    const row = list.find((r) => r.pid === tracked.pid);
+    leftovers.push({ pid: tracked.pid, command: row?.command ?? '(unknown)' });
+  }
+  for (const pid of desc) {
+    if (!isKillablePid(pid)) continue;
+    if (!isAlive(pid, deps)) continue;
+    const row = list.find((r) => r.pid === pid);
+    leftovers.push({ pid, command: row?.command ?? '(unknown)' });
+  }
+  if (!leftovers.length) return;
+
+  const parts = leftovers.map((l) => `pid ${l.pid} (${l.command})`);
+  throw new Error(`leftover browser process(es): ${parts.join('; ')}`);
+}
