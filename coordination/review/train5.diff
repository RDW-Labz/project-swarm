+<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
+<meta charset="utf-8">
+<title>Swarm Watch Command Center</title>
+<meta name="claude:viewport-fit-sides" content="cover">
+<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oxanium:wght@500;600;700;800&family=Geist+Mono:wght@400;500;600&family=Instrument+Serif:ital@1&family=Playfair+Display:ital,wght@1,700;1,800;1,900&display=swap">
+<style>
+/* Layout: a radial Hive (project cards on an ellipse around a neon ring with the swarm brain inside, comet streams from every card into the ring), three dense panels under it; the Cockpit mirrors the second reference: ticket columns left and right, the orchestrator in the middle, a loop strip, a worker stream and a stack of counters. Real ledger data and real robot heads only. */
+:root{
+  --bg:#05060b;--panel:#0a0c14;--panel2:#0e111b;--line:#1c2233;--fg:#e9eef8;--muted:#7d8aa3;--dim:#4b566d;
+  --blue:#4d7cff;--green:#2fe0a0;--red:#ff4d7e;--amber:#ffb62e;--violet:#a98bff;--cyan:#4ccce6;--gray:#58627a;
+  --font-head:"Oxanium","Trebuchet MS",system-ui,sans-serif;--font-mono:"Geist Mono",ui-monospace,Menlo,monospace;--font-serif:"Instrument Serif",Georgia,serif;--font-display:"Playfair Display","Instrument Serif",Georgia,serif;--font-body:system-ui,-apple-system,"Segoe UI",sans-serif;
+  color-scheme:dark}
+/* single dark look by design (neon HUD); all colours explicit so it reads on any host background */
+*{box-sizing:border-box}
+html{background:#05060b;overflow-x:hidden}
+body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--font-body);font-size:15px;line-height:1.4;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-bottom:30px}
+.mono{font-family:var(--font-mono);font-variant-numeric:tabular-nums}
+button{font:inherit;font-size:13px;background:var(--panel2);color:var(--fg);border:1px solid var(--line);border-radius:8px;padding:6px 10px;cursor:pointer}
+button:hover{border-color:var(--blue)} :focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
+.wrap{max-width:1320px;margin:0 auto}
+.top{display:flex;flex-wrap:wrap;align-items:center;gap:10px 22px;padding:18px 0 14px;border-bottom:1px solid var(--line)}
+.logo{font-family:var(--font-display);font-style:italic;font-weight:900;font-size:44px;letter-spacing:-.01em;filter:drop-shadow(0 0 14px rgba(255,77,126,.35));line-height:1;background:linear-gradient(90deg,#ff4d7e,#a98bff);-webkit-background-clip:text;background-clip:text;color:transparent}
+.tag{font-family:var(--font-mono);font-size:12.5px;color:#c9d1e3;line-height:1.75;white-space:nowrap}
+.cnt{display:flex;gap:26px;margin-left:auto}
+.cnt div{text-align:center}.cnt .l{font-family:var(--font-mono);font-size:10px;letter-spacing:.2em;color:var(--dim);text-transform:uppercase}.cnt .v{font-family:var(--font-mono);font-size:24px;font-weight:500}
+.live{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:12px;letter-spacing:.2em}
+.live i{width:8px;height:8px;border-radius:50%;background:var(--red);box-shadow:0 0 10px var(--red);animation:beat 1.8s ease-in-out infinite}
+@keyframes beat{0%,100%{opacity:1}50%{opacity:.35}}
+.nav{display:flex;flex-wrap:wrap;gap:4px;align-items:center;padding:8px 0}
+.nav .crumbs{font-size:13px;color:var(--muted);display:flex;gap:6px}.nav .crumbs button{background:none;border:0;padding:0;color:var(--cyan);cursor:pointer}
+.nav .tabs{margin-left:auto;display:flex;gap:4px;flex-wrap:wrap}.nav .tabs button{background:none;border:1px solid transparent;color:var(--muted)}.nav .tabs button[aria-selected=true]{background:var(--panel2);border-color:var(--line);color:var(--fg)}
+.view{display:none}.view.on{display:block}
+/* HIVE stage */
+.stage{position:relative;height:860px;max-width:1320px;margin:0 auto}
+.stage canvas{position:absolute;inset:0;width:100%;height:100%}.stage canvas.gl{position:absolute;inset:auto;order:0;aspect-ratio:auto;max-width:none;margin:0}
+.card{position:absolute;width:262px;transform:translate(-50%,-50%);background:#07080f;border:2px solid var(--c);border-radius:10px;box-shadow:0 0 0 1px color-mix(in srgb,var(--c) 85%,transparent),0 0 8px 1px var(--c),0 0 18px 2px color-mix(in srgb,var(--c) 80%,transparent),0 0 44px 8px color-mix(in srgb,var(--c) 38%,transparent),0 0 70px 16px color-mix(in srgb,var(--c) 12%,transparent),inset 0 0 26px -10px color-mix(in srgb,var(--c) 45%,transparent);cursor:pointer;transition:transform .2s,box-shadow .2s}
+.card:hover{transform:translate(-50%,-52%);box-shadow:0 0 30px 0 var(--c),inset 0 0 18px -8px var(--c)}
+.card .hd{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:5px 9px;background:var(--c);color:#05060b;font-family:var(--font-mono);font-weight:600;font-size:13px;border-radius:7px 7px 0 0}
+.card .hd .k{opacity:.7;margin-right:6px}.card .hd .t{font-size:8px;letter-spacing:.12em;flex:none}
+.card .hd .hb{display:flex;margin-left:auto;margin-right:8px;flex:none}.card .hd>span:first-child{flex:1}
+.card .bd{padding:6px 10px 7px;font-family:var(--font-mono);font-size:11px;line-height:1.3;display:grid;gap:3px}.card .r span:last-child{color:#f1f4fa}
+.card .r{display:flex;justify-content:space-between;gap:10px}.card .r span:first-child{color:var(--dim)}.card .r span:last-child{text-align:right}
+.card .pb{display:flex;align-items:center;gap:10px;margin-top:5px}.card .pb b{color:var(--c);font-weight:500;min-width:38px}
+.card .pb i{flex:1;height:5px;border-radius:3px;background:#161b29;overflow:hidden}.card .pb i u{display:block;height:100%;background:var(--c);box-shadow:0 0 8px var(--c);transform-origin:left}
+.card .pb em{font-style:normal;color:var(--text,#cfd8ea)}
+.card.off{width:224px;filter:none;opacity:.8;border-color:#4a505e;box-shadow:0 0 14px 0 rgba(255,255,255,.07)}.card.off .hd{background:#3a3f4a;color:#c3c9d6}.card .hd>span:first-child{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;display:block}.card .hd .t{white-space:nowrap}
+.ringfx{position:absolute;left:50%;top:50%;width:min(520px,90vw);height:min(520px,90vw);transform:translate(-50%,-50%);border-radius:50%;border:2px solid rgba(255,77,126,.0);pointer-events:none}
+.core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:220px;text-align:center;pointer-events:none}
+.core .a{font-family:var(--font-mono);font-size:9px;letter-spacing:.3em;color:#8d99b3;margin-bottom:4px}
+.core .n{font-family:var(--font-display);font-style:italic;font-weight:800;font-size:50px;line-height:1;margin:2px 0 6px;color:#f4f6fb;text-shadow:0 0 22px rgba(176,107,255,.6)}
+.core .s{font-family:var(--font-mono);font-size:12px;color:var(--violet)}
+.core .x{font-family:var(--font-mono);font-size:10px;color:var(--dim);margin-top:4px}
+.legend{display:flex;flex-wrap:wrap;gap:8px 22px;font-family:var(--font-mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:6px 4px;align-items:center}
+.legend span i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:7px;box-shadow:0 0 8px currentColor}
+.legend .tl{margin-left:auto;font-family:var(--font-serif);font-style:italic;font-size:26px;text-transform:none;letter-spacing:0;color:var(--violet)}
+.legend .tl b{font-weight:400;color:var(--red)}.legend .tl u{text-decoration:none;color:var(--fg)}
+.sim{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:10px 0;color:var(--muted);font-size:12px}
+/* bottom panels */
+.panels,.panels *,.sim,.sim button{font-family:var(--font-mono)}.panels .big{font-family:var(--font-head)}.panels .hint{font-size:11px}
+.panels{display:grid;grid-template-columns:repeat(3,1fr);background:var(--panel);border:1px solid var(--line);border-radius:14px;margin-top:10px}
+.panels>section{padding:22px 24px;min-width:0;border-right:1px solid var(--line)}.panels>section:last-child{border:0}
+.panels h2{font-family:var(--font-mono);font-size:11px;letter-spacing:.3em;color:var(--muted);font-weight:500;margin:0 0 16px;text-transform:uppercase}
+.slog{display:grid;gap:5px;font-family:var(--font-mono);font-size:11px;line-height:1.35}.slog>div{display:grid;grid-template-columns:52px minmax(0,1fr);gap:8px}.slog>div>span{display:block;overflow-wrap:anywhere}.slog b{font-weight:500}.slog span{color:var(--muted)}
+.bars{display:flex;align-items:flex-end;gap:3px;height:70px;margin-top:14px}.bars i{flex:1;border-radius:2px 2px 0 0;min-height:3px;transform-origin:bottom}
+.cap{font-family:var(--font-mono);font-size:11px;color:var(--dim);margin-top:6px}
+.big{font-family:var(--font-head);font-weight:800;font-size:72px;line-height:1;color:var(--red);text-shadow:0 0 22px rgba(255,77,126,.5)}
+.big small{font-family:var(--font-mono);font-weight:400;font-size:14px;color:var(--muted);text-shadow:none;margin-left:10px}
+.hbar{display:grid;grid-template-columns:70px 1fr 56px;gap:10px;align-items:center;font-family:var(--font-mono);font-size:12px;margin:9px 0}
+.hbar i{height:6px;border-radius:3px;background:#161b29;overflow:hidden}.hbar i u{display:block;height:100%;border-radius:3px;box-shadow:0 0 8px currentColor;transform-origin:left}
+.hbar span:last-child{text-align:right}
+.kv{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:12px;color:var(--muted);margin:7px 0}.kv b{font-weight:500}
+.step{display:block;width:100%;height:70px;margin-top:10px}.step path{fill:none;stroke:var(--red);stroke-width:2;filter:drop-shadow(0 0 5px rgba(255,77,126,.8))}
+/* COCKPIT: one mono family for every row, label, tag, loop and stream line; heavy sans only for the big title and counters */
+.gbar{display:contents}
+.wrap.ck .gbar{display:flex;align-items:center;gap:16px;padding:5px 0;border-bottom:1px solid var(--line);white-space:nowrap;min-width:0}
+.wrap.ck .top{padding:0;border:0;gap:14px;flex-wrap:nowrap}.wrap.ck .logo{font-size:21px}.wrap.ck .tag{display:none}
+.wrap.ck .cnt{gap:14px;margin-left:0}.wrap.ck .cnt>div{display:flex;gap:5px;align-items:baseline}.wrap.ck .cnt .l{font-size:9px;letter-spacing:.14em;color:#8d99b3}.wrap.ck .cnt .v{font-size:13px;font-weight:600}.wrap.ck .cnt .v.has-tip{border-bottom:0}
+.wrap.ck .live{font-size:10px;letter-spacing:.16em}
+.wrap.ck .nav{padding:0;flex:1;flex-wrap:nowrap;min-width:0}.wrap.ck .nav .crumbs{font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase}
+.wrap.ck .nav .tabs{flex-wrap:nowrap}.wrap.ck .nav .tabs button{font-family:var(--font-mono);font-size:11px;padding:3px 8px;border-radius:5px}
+.ct{padding:0}
+.ct h1{font-family:var(--font-head);font-weight:800;font-size:54px;letter-spacing:.01em;margin:12px 0 0;line-height:1}
+.ct .sub2{font-family:var(--font-head);font-weight:700;font-size:26px;color:var(--amber);margin:8px 0 16px;line-height:1.1}
+.strip{display:flex;gap:4px;height:3px;margin:8px 0 0}.strip i{flex:1}
+.stripl{display:flex;justify-content:space-between;gap:12px;font-family:var(--font-mono);font-size:10px;font-weight:600;letter-spacing:.18em;color:#c3cbe0;text-transform:uppercase;white-space:nowrap}.stripl span{overflow:hidden;text-overflow:ellipsis;min-width:0}.stripl>span:last-child{color:var(--red);flex:none}
+.cols{display:grid;grid-template-columns:1fr 340px 1fr;gap:0 60px;align-items:stretch;margin-top:16px}
+.col{display:grid;grid-template-columns:minmax(0,1fr);gap:18px;align-content:start;min-width:0}
+.tk{position:relative;z-index:1;display:grid;grid-template-columns:30px minmax(0,1fr) auto;gap:0 11px;align-items:center;min-height:56px;background:#0b0e17;border:1.5px solid #2e364a;border-left:4px solid var(--c);border-radius:5px;padding:6px 10px 6px 8px;font-family:var(--font-mono)}
+.tk .no{display:grid;place-items:center;width:30px;height:30px;border-radius:4px;background:var(--c);color:#05060b;font-family:var(--font-mono);font-size:11px;font-weight:600}
+.tk .tx{min-width:0}.tk .tx.has-tip{border-bottom:0;cursor:default}
+.tk .nm{font-family:var(--font-mono);font-size:13px;font-weight:600;line-height:1.15;color:#f1f4fa;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.tk .sb{font-family:var(--font-mono);font-size:10px;line-height:1.15;color:#8d99b3;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.tk .rt{align-self:stretch;display:flex;flex-direction:column;align-items:flex-end;justify-content:space-between;font-family:var(--font-mono);font-size:9px;font-weight:600;letter-spacing:.16em;color:var(--c);line-height:1}
+.tk .rt b{font-size:15px;font-weight:400;letter-spacing:0;color:#d5dbe8}
+.tk.hot{border:2px solid #e3e8f3;border-left:4px solid var(--c);background:#151a28;box-shadow:0 0 22px -6px rgba(227,232,243,.35)}
