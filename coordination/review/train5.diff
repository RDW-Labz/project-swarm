+/* SPDX-License-Identifier: Apache-2.0 */
+/* Command Center Cockpit, styled after the owner's target (docs/design/reference/cockpit-target.png); every selector scoped under
+   .cc-cockpit-shell. Generic names from the artifact port are .ck-top .ck-nav .ck-live .ck-foot .ck-hint .stack so they cannot meet
+   page-level rules. Fonts and the shared tokens come from /assets/cc-theme.css; the values below repeat them only as a fallback.
+   Category colours arrive as --cat-color on each row, segment and legend entry (cockpit-lists.js). */
+
+.cc-cockpit-shell {
+  --bg: #05060b; --panel: #0a0c14; --panel2: #0e111b; --line: #1c2233; --fg: #e9eef8; --muted: #7d8aa3; --dim: #4b566d;
+  --blue: #4d7cff; --green: #2fe0a0; --red: #ff4d7e; --amber: #ffb62e; --violet: #a98bff; --cyan: #4ccce6; --gray: #58627a;
+  --font-head: "Oxanium", "Trebuchet MS", system-ui, sans-serif;
+  --font-mono: "Geist Mono", ui-monospace, Menlo, monospace;
+  --font-serif: "Instrument Serif", Georgia, serif;
+  --font-display: "Playfair Display", "Instrument Serif", Georgia, serif;
+  --font-body: system-ui, -apple-system, "Segoe UI", sans-serif;
+  /* target look: charcoal ground, light hairline cards, one warm accent */
+  --ck-heavy: system-ui, -apple-system, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
+  --ck-accent: #ff7a45;
+  --ck-coral: #ff6a4d;
+  --ck-edge: rgba(196, 200, 214, .45);
+  --ck-edge-hi: #e6e9f2;
+  --ck-card: rgba(22, 22, 27, .94);
+  --ck-panel: rgba(24, 24, 29, .9);
+  --ck-panel-line: #2c2d36;
+  --ck-sep: #5d6273;
+  --cell: 24px;
+  color-scheme: dark;
+  box-sizing: border-box;
+  width: 100%;
+  min-height: 100vh;
+  margin: 0;
+  /* the bottom pad keeps the stack footer clear of the tour's fixed help button (cc-tour.js) at full scroll */
+  padding: 0 max(16px, env(safe-area-inset-right, 0px)) 72px max(16px, env(safe-area-inset-left, 0px));
+  color: var(--fg);
+  font-family: var(--font-body);
+  font-size: 15px;
+  line-height: 1.4;
+  overflow-x: hidden;
+  background:
+    radial-gradient(ellipse 46% 40% at 50% 38%, rgba(255, 122, 69, .07), transparent 72%),
+    radial-gradient(ellipse 120% 90% at 50% 40%, transparent 60%, rgba(0, 0, 0, .45) 100%),
+    linear-gradient(rgba(255, 255, 255, .016) 1px, transparent 1px) 0 0 / 32px 32px,
+    linear-gradient(90deg, rgba(255, 255, 255, .016) 1px, transparent 1px) 0 0 / 32px 32px,
+    #121216;
+  background-attachment: fixed, fixed, scroll, scroll, scroll;
+}
+.cc-cockpit-shell *, .cc-cockpit-shell *::before, .cc-cockpit-shell *::after { box-sizing: border-box; }
+.cc-cockpit-shell [hidden] { display: none !important; }
+.cc-cockpit-shell button { font: inherit; font-size: 13px; background: var(--panel2); color: var(--fg); border: 1px solid var(--line); border-radius: 8px; padding: 6px 10px; cursor: pointer; }
+.cc-cockpit-shell button:hover { border-color: var(--blue); }
+.cc-cockpit-shell :focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
+.cc-cockpit-shell .ck-wrap { max-width: 1320px; margin: 0 auto; }
+.cc-cockpit-shell .panel-cockpit { display: block; min-width: 0; }
+.cc-cockpit-shell .ck-hint { color: var(--muted); font-size: 11px; font-family: var(--font-mono); }
+.cc-cockpit-shell .cockpit-ticket-empty { margin: 0; padding: 10px 2px; line-height: 1.45; }
+
+/* top line: plain mono breadcrumb left, meta line right, view switch in a small overflow */
+.cc-cockpit-shell .gbar { display: flex; align-items: center; gap: 14px; padding: 10px 0 0; min-width: 0; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; line-height: 1.3; white-space: nowrap; }
+.cc-cockpit-shell .crumbs { display: flex; align-items: center; gap: 8px; min-width: 0; color: #f1f4fa; font: inherit; letter-spacing: inherit; text-transform: inherit; }
+.cc-cockpit-shell .sep { color: var(--ck-sep); font-weight: 600; }
+/* the SWARM wordmark is plain crumb text (no tile); the reset guards against page-level logo styles */
+.cc-cockpit-shell .ck-brand { display: inline-block; width: auto; height: auto; margin: 0; padding: 0; border: 0; border-radius: 0; background: none; box-shadow: none; color: #f1f4fa; font: inherit; letter-spacing: inherit; text-transform: uppercase; }
+.cc-cockpit-shell .crumbs .cc-cockpit-back-btn { background: none; border: 0; border-radius: 0; padding: 0; color: inherit; font: inherit; letter-spacing: inherit; text-transform: uppercase; cursor: pointer; }
+.cc-cockpit-shell .crumbs .cc-cockpit-back-btn:hover, .cc-cockpit-shell .crumbs .cc-cockpit-back-btn:focus-visible { color: var(--ck-accent); }
+.cc-cockpit-shell .crumbs .cur { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.cc-cockpit-shell .ck-meta { margin-left: auto; display: flex; align-items: center; gap: 8px; color: #d9dde7; min-width: 0; }
+.cc-cockpit-shell .cnt { display: flex; gap: 8px; }
+.cc-cockpit-shell .cnt > div { display: flex; gap: 5px; align-items: baseline; }
+.cc-cockpit-shell .cnt > div + div::before { content: "/"; order: -2; color: var(--ck-sep); margin-right: 3px; }
+.cc-cockpit-shell .cnt .l { font: inherit; letter-spacing: inherit; color: #d9dde7; text-transform: uppercase; }
+.cc-cockpit-shell .cnt .v { order: -1; font: inherit; letter-spacing: .04em; font-variant-numeric: tabular-nums; color: #f1f4fa; }
+.cc-cockpit-shell .cnt .v.has-tip { border-bottom: 0; }
+.cc-cockpit-shell .ck-meta .dt { font-variant-numeric: tabular-nums; }
+.cc-cockpit-shell .ck-live { display: flex; align-items: center; gap: 6px; margin-left: 6px; color: var(--ck-coral); }
+/* live chips beat on one 1.6 s clock (CSS keyframes, so they run on the compositor and stop under reduced motion) */
+.cc-cockpit-shell .ck-live i { width: 7px; height: 7px; border-radius: 50%; background: var(--ck-coral); box-shadow: 0 0 10px var(--ck-coral); animation: cc-ck-beat 1.6s ease-in-out infinite; }
+@keyframes cc-ck-beat {
+  0%, 100% { opacity: 1; transform: scale(1); box-shadow: 0 0 12px var(--ck-coral); }
+  50% { opacity: .35; transform: scale(.7); box-shadow: 0 0 3px var(--ck-coral); }
+}
+@keyframes cc-ck-blinkon { 0%, 100% { opacity: 1; } 50% { opacity: .45; } }
+.cc-cockpit-shell .ck-more { position: relative; flex: none; }
+.cc-cockpit-shell .ck-more summary { list-style: none; cursor: pointer; color: #d9dde7; padding: 0 2px; letter-spacing: .08em; }
+.cc-cockpit-shell .ck-more summary::-webkit-details-marker { display: none; }
+.cc-cockpit-shell .ck-more summary:hover { color: #f1f4fa; }
+.cc-cockpit-shell .ck-more .tabs { position: absolute; right: 0; top: calc(100% + 8px); z-index: 30; display: flex; flex-direction: column; gap: 2px; min-width: 150px; padding: 6px; border: 1px solid var(--ck-panel-line); border-radius: 6px; background: #17171c; box-shadow: 0 10px 30px rgba(0, 0, 0, .5); }
+.cc-cockpit-shell .tabs a, .cc-cockpit-shell .tabs button { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: none; padding: 5px 8px; border-radius: 4px; background: none; border: 1px solid transparent; color: var(--muted); text-decoration: none; }
+.cc-cockpit-shell .tabs a:hover { color: #f1f4fa; background: rgba(255, 255, 255, .05); }
+.cc-cockpit-shell .tabs [aria-current="page"] { background: #23232a; border-color: var(--ck-panel-line); color: var(--fg); }
+.cc-router-bar { display: flex; align-items: center; padding: 10px 16px; border-bottom: 1px solid rgba(34, 211, 238, .18); background: rgba(8, 12, 24, .72); }
+.cc-router-bar .crumbs { font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); display: flex; gap: 6px; align-items: center; }
+.cc-router-bar .crumbs button { background: rgba(34, 211, 238, .08); border: 1px solid rgba(34, 211, 238, .4); border-radius: 999px; padding: 3px 10px; color: var(--cyan); cursor: pointer; font-size: inherit; font-family: inherit; letter-spacing: inherit; text-transform: inherit; }
+.cc-router-bar .crumbs button:hover, .cc-router-bar .crumbs button:focus-visible { background: rgba(34, 211, 238, .18); outline: none; }
+
+/* title block */
+.cc-cockpit-shell .ct { padding: 0; }
+.cc-cockpit-shell .ct h1 { font-family: var(--ck-heavy); font-weight: 900; font-size: 56px; letter-spacing: -.03em; margin: 16px 0 0; line-height: 1; color: #f4f5f8; overflow-wrap: anywhere; }
+.cc-cockpit-shell .ct .sub2 { font-family: var(--ck-heavy); font-weight: 800; font-size: 28px; letter-spacing: -.015em; color: var(--ck-accent); margin: 10px 0 24px; line-height: 1.1; }
+.cc-cockpit-shell .stripl { display: flex; align-items: baseline; gap: 10px; font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: .16em; color: #d9dde7; text-transform: uppercase; white-space: nowrap; min-width: 0; }
+.cc-cockpit-shell .stripl .st { flex: none; }
+.cc-cockpit-shell .stripl .lg { order: 1; flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
+.cc-cockpit-shell .stripl .lg i { font-style: normal; color: var(--ck-sep); margin: 0 8px; }
+.cc-cockpit-shell .stripl .lg b { font-weight: 700; color: var(--cat-color, #d9dde7); }
+.cc-cockpit-shell .stripl .lv { order: 2; flex: none; margin-left: auto; color: var(--ck-coral); display: flex; align-items: center; gap: 7px; }
+.cc-cockpit-shell .stripl .lv::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--ck-coral); box-shadow: 0 0 10px var(--ck-coral); animation: cc-ck-beat 1.6s ease-in-out infinite; }
+/* segmented rule: stage groups of per-ticket segments, done at full strength, a scan light sweeping across */
+.cc-cockpit-shell .strip { position: relative; display: flex; gap: 6px; height: 3px; margin: 10px 0 0; overflow: hidden; }
+.cc-cockpit-shell .strip > i { display: flex; gap: 6px; flex: 1 1 0; min-width: 0; background: none !important; }
+.cc-cockpit-shell .strip > i:empty { background: #2a2c35 !important; }
+.cc-cockpit-shell .strip b { flex: 1 1 0; min-width: 2px; background: var(--cat-color, #58627a); opacity: .35; }
+.cc-cockpit-shell .strip b.done { opacity: 1; }
+.cc-cockpit-shell .strip::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 0, transparent 84%, rgba(255, 255, 255, .95) 94%, transparent 100%); mix-blend-mode: screen; transform: translateX(-100%); animation: cc-ck-sweep 3.6s linear infinite; pointer-events: none; }
+@keyframes cc-ck-sweep { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
+
+/* ticket columns */
+.cc-cockpit-shell .cols { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 380px minmax(0, 1fr); gap: 0 56px; align-items: stretch; margin-top: 20px; }
+.cc-cockpit-shell .col { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; align-content: start; min-width: 0; }
+/* both columns span the row band down to the loop strip, so a shorter column never leaves an empty block */
+.cc-cockpit-shell .col.spread { align-content: space-between; }
+.cc-cockpit-shell .tk { position: relative; z-index: 1; display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 0 12px; align-items: center; min-height: 54px; background: var(--ck-card); border: 1.5px solid var(--ck-edge); border-left: 4px solid var(--cat-color, #58627a); border-radius: 4px; padding: 7px 10px 7px 9px; font-family: var(--font-mono); }
+.cc-cockpit-shell .tk .no { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 3px; background: var(--cat-color, #58627a); color: #1b0f0b; color: color-mix(in srgb, var(--cat-color, #58627a) 28%, #000); font-family: var(--font-mono); font-size: 11px; font-weight: 700; }
+.cc-cockpit-shell .tk .tx { min-width: 0; }
+.cc-cockpit-shell .tk .tx.has-tip { border-bottom: 0; cursor: default; }
+.cc-cockpit-shell .tk .nm { font-family: var(--font-mono); font-size: 14px; font-weight: 700; line-height: 1.15; color: #f1f4fa; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.cc-cockpit-shell .tk .sb { font-family: var(--font-mono); font-size: 10px; line-height: 1.15; color: #7f8597; margin-top: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.cc-cockpit-shell .tk .rt { align-self: stretch; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; padding: 1px 0; font-family: var(--font-mono); line-height: 1; }
+.cc-cockpit-shell .tk .rt b { font-size: 15px; font-weight: 400; color: #d5dbe8; }
+.cc-cockpit-shell .tk .rt b.g-ready { color: #c9cedb; font-size: 12px; }
+.cc-cockpit-shell .tk .rt b.g-done { color: #e6e9f2; font-size: 16px; }
