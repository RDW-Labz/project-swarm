+
+  cards[0].dispatchEvent({ type: 'click' });
+  cards[1].dispatchEvent({ type: 'keydown', key: 'Enter', preventDefault() {} });
+  assert.deepEqual(opened, ['proj-a', 'proj-b']);
+
+  handle.destroy();
+  assert.equal(host.children.length, 0);
+});
