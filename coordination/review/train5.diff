+.cc-cockpit-shell .tk.active { border: 2px solid var(--ck-edge-hi); border-left: 4px solid var(--cat-color, #58627a); background: rgba(44, 44, 52, .97); box-shadow: 0 0 14px -4px rgba(230, 233, 242, .32); }
+.cc-cockpit-shell .tk.active::after { content: ""; position: absolute; inset: -2px -2px -2px -4px; border-radius: 5px; box-shadow: 0 0 0 3px rgba(230, 233, 242, .08), 0 0 26px -4px rgba(230, 233, 242, .4); opacity: 0; pointer-events: none; animation: cc-ck-breathe 1.6s ease-in-out infinite; }
+@keyframes cc-ck-breathe { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
+.cc-cockpit-shell .tk.active .sb { color: #9aa0b2; }
+/* "+n more" closes a truncated column: same frame, dashed and muted, so the row numbers still add up */
+.cc-cockpit-shell .tk.more { border: 1.5px dashed rgba(196, 200, 214, .32); border-left: 4px solid #3a3c47; background: rgba(22, 22, 27, .7); }
+.cc-cockpit-shell .tk.more .no { background: #2a2c35; color: #c3c7d3; }
+.cc-cockpit-shell .tk.more .nm { color: #c3c7d3; }
+.cc-cockpit-shell .tk.more .rt b { color: #6f7486; }
+.cc-cockpit-shell .tk.more .rt .tag { color: #6f7486; }
+
+/* orbit ellipse, orbit dots and the dotted path to the active row (drawn by the mount under the columns) */
+.cc-cockpit-shell .ck-wire { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 0; overflow: visible; pointer-events: none; }
+/* dash offsets of the ring, the inner ring, the path and the orange pulse are moved each frame by the mount */
+.cc-cockpit-shell .ck-wire .ring { fill: none; stroke: rgba(214, 216, 226, .4); stroke-width: 1.2; stroke-dasharray: 84 5; }
+.cc-cockpit-shell .ck-wire .ring2 { fill: none; stroke: rgba(255, 122, 69, .24); stroke-width: 1; stroke-dasharray: 2 7; }
