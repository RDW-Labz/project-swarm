+// SPDX-License-Identifier: Apache-2.0
+// Project-wide spend: the total of every run in this repository (.swarm/runs/*/state.json), and the optional cap on it.
+// --max-usd stays per run; this cap refuses NEW runs once the project total has reached it. A review re-ask is a run, so it counts.
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { runTotals } from './spend.mjs';
+import { loadLocalConfig } from './local-config.mjs';
+
+const finite = value => typeof value === 'number' && Number.isFinite(value) && value > 0;
+
+export async function projectSpend(root) {
+  const dir = path.join(root, '.swarm', 'runs');
+  let ids = [];
+  try { ids = await fs.readdir(dir); } catch { /* no runs yet */ }
+  const total = { usd: 0, tokens: 0, runs: 0, unreadable: [], unknownUsd: 0 };
+  for (const id of ids) {
+    let state;
+    try { state = JSON.parse(await fs.readFile(path.join(dir, id, 'state.json'), 'utf8')); } catch (error) {
+      if (error.code !== 'ENOENT') total.unreadable.push(id);
+      continue;
+    }
+    const run = runTotals(state);
+    total.usd += run.usd; total.tokens += run.tokens; total.runs++; total.unknownUsd += run.unknownUsd.length;
+  }
+  return total;
+}
+
+// The lower of the profile cap and the local-config cap; null when neither is set. A malformed value is an error, never "no cap".
+export function projectCap({ profile, config } = {}) {
+  const found = [];
+  for (const [source, value] of [['profile budget.projectMaxUsd', profile?.budget?.projectMaxUsd], ['config spend.projectMaxUsd', config?.spend?.projectMaxUsd]]) {
+    if (value === undefined || value === null) continue;
+    if (!finite(value)) throw Object.assign(new Error(`project-cap-invalid: ${source} must be a number above 0`), { code: 'project-cap-invalid' });
+    found.push(value);
+  }
+  return found.length ? Math.min(...found) : null;
+}
+
+export function projectCapDecision({ spent, cap }) {
+  if (cap === null || cap === undefined || spent.usd < cap) return null;
+  return { reason: 'project-cap', spent: spent.usd, cap, message: `project-cap: this project has spent $${spent.usd.toFixed(2)} across ${spent.runs} runs >= the project cap $${cap.toFixed(2)}; no new run starts. Raising it needs the owner (profile budget.projectMaxUsd)` };
+}
+
+export async function checkProjectCap(root, { profile, config } = {}) {
+  const cap = projectCap({ profile, config });
+  if (cap === null) return null;
+  return projectCapDecision({ spent: await projectSpend(root), cap });
+}
+
+// What swarm watch shows: the project total, the cap (or null), and whether the cap is reached. Never throws (a broken cap shows as null).
+export async function projectSummary(root, { env = process.env } = {}) {
+  const spent = await projectSpend(root);
+  let cap = null;
+  try {
+    let pointer = null;
+    try { pointer = JSON.parse(await fs.readFile(path.join(root, '.project-swarm.json'), 'utf8')); } catch { /* no pointer */ }
+    cap = projectCap({ profile: pointer?.profile, config: loadLocalConfig({ env }) });
+  } catch { cap = null; }
+  return { spendUsd: Math.round(spent.usd * 100) / 100, runs: spent.runs, capUsd: cap, reached: cap !== null && spent.usd >= cap, unknownUsd: spent.unknownUsd };
+}
