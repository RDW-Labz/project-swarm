+  phone: {
+    width: 390,
+    height: 844,
+    throttle: {
+      offline: false,
+      latency: 100,
+      downloadThroughput: Math.floor((1.6 * 1_000_000) / 8),
+      uploadThroughput: Math.floor((750 * 1_000) / 8),
