+  assert.equal((await f.get('/api/command-center/project?id=missing')).status, 404);
+  assert.equal(f.reads(), 4);
+  f.advance(2001);
+  assert.equal((await f.get('/api/command-center', { 'if-none-match': tag })).status, 304);
+  assert.equal(f.reads(), 5);
+  f.revise();
+  f.advance(2001);
