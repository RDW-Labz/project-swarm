+      "outputs": ["tools/watch-perf.mjs", "package.json"],
+      "timeoutMs": 1800000
+    }
+  ],
+  "checks": [ { "name": "t6-perf-script", "argv": ["node", "--check", "tools/watch-perf.mjs"] } ]
+}
