+  const h = await harness(t);
+  assert.equal((await h.run('funnel')).exitCode, 2);
+  assert.equal((await h.run('on', '--public')).exitCode, 2);
+  assert.equal((await h.run('serve')).exitCode, 2);
+  assert.deepEqual(await h.calls(), []);
+});
