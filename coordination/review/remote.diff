+export function isTailnetAddress(ip) {
+  if (net.isIPv4(ip)) { const [a, b] = ip.split('.').map(Number); return a === 100 && b >= 64 && b <= 127; }
+  return /^fd7a:115c:a1e0:/i.test(ip);
