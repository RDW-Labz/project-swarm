+  const concurrency = raw.concurrency ?? RENTED_DEFAULTS.concurrency;
+  if (!(Number.isInteger(concurrency) && concurrency >= 1 && concurrency <= 2048)) errors.push('rentedGpu.concurrency: must be an integer from 1 to 2048');
