+      endpoint: origin,
+      model: raw.model,
+      keyItem: { service: keyItem.service, account: keyItem.account },
+      hourlyUsd,
+      maxHoursPerRun,
+      concurrency,
+      dailyUsd,
+      auth,
+      endpoints: origins,
+      chatUrls: origins.map(item => `${item}/v1/chat/completions`),
+      chatUrl: `${origin}/v1/chat/completions`,
+      modelsUrl: `${origin}/v1/models`,
