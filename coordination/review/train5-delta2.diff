+function makeClassList() {
+  const set = new Set();
+  return {
+    add: (...c) => c.forEach(x => set.add(x)),
+    remove: (...c) => c.forEach(x => set.delete(x)),
+    contains: c => set.has(c),
+    toString: () => [...set].join(' '),
+  };
+}
+
+function makeElement(tag) {
+  const classList = makeClassList();
+  const node = {
+    tagName: String(tag).toUpperCase(),
+    classList,
+    children: [],
+    attributes: {},
+    style: {},
+    parentNode: null,
+    hidden: false,
+    appendChild(child) {
+      this.children.push(child);
+      child.parentNode = this;
+      return child;
+    },
+    removeChild(child) {
+      const i = this.children.indexOf(child);
+      if (i >= 0) this.children.splice(i, 1);
+      return child;
+    },
+    setAttribute(k, v) { this.attributes[k] = String(v); },
+    getAttribute(k) { return this.attributes[k] ?? null; },
+    addEventListener() {},
+    removeEventListener() {},
+    querySelectorAll(sel) {
+      const out = [];
+      const walk = n => {
+        if (!n?.children) return;
+        for (const c of n.children) {
+          if (c.classList?.contains('tabs')) {
+            for (const child of c.children || []) {
+              if (child.tagName === 'A') out.push(child);
+            }
+          }
+          walk(c);
+        }
+      };
+      walk(this);
+      return sel.includes('.tabs') ? out : out;
+    },
+    querySelector(sel) { return this.querySelectorAll(sel)[0] ?? null; },
+    getBoundingClientRect() { return { top: 0, left: 0, bottom: 40, right: 120, width: 120, height: 40 }; },
+  };
+  Object.defineProperty(node, 'className', {
+    get() { return classList.toString(); },
+    set(v) { classList.add(...String(v).split(/\s+/).filter(Boolean)); },
+  });
+  return node;
+}
+
+function makeDocument(defaultView) {
+  const document = {
+    hidden: false,
+    defaultView,
+    createElement: tag => {
+      const el = makeElement(tag);
+      el.ownerDocument = document;
+      return el;
+    },
+    createTextNode: text => ({ nodeType: 3, textContent: text }),
+    createElementNS: () => makeElement('svg'),
+    fonts: { ready: Promise.resolve() },
+  };
+  return document;
+}
