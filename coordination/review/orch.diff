+// SPDX-License-Identifier: Apache-2.0
+// Tokens and list cost of an orchestrator session, read from its Claude Code transcript (the jsonl file whose path the hooks record). A subscription session costs nothing extra: the
+// dollars here are what the same tokens would cost at list price, and the board marks them that way. Read-only; the file is read once and then only what was appended.
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { MODEL_RATES } from './rates.mjs';
+
+const familyOf = model => { const m = String(model ?? '').toLowerCase(); return m.includes('opus') ? 'opus' : m.includes('sonnet') ? 'sonnet' : m.includes('haiku') ? 'haiku' : null; };
+const cache = new Map();   // path -> { offset, tail, messages: Map(id -> entry) }
+
+function priceOf(entry) {
+  const rate = MODEL_RATES[entry.family];
+  if (!rate) return null;
+  return (entry.input / 1e6) * rate.in + (entry.output / 1e6) * rate.out + (entry.cacheWrite / 1e6) * rate.cacheWrite + (entry.cacheRead / 1e6) * rate.cacheRead;
+}
+
+// The transcript path comes from an events file inside the project, which anything could write: only files under Claude Code's own folder (~/.claude, or the folders named in
+// SWARM_TRANSCRIPT_ROOTS, for tests) are ever read, by their real path.
+function allowed(file) {
+  const roots = (process.env.SWARM_TRANSCRIPT_ROOTS ? process.env.SWARM_TRANSCRIPT_ROOTS.split(path.delimiter) : [path.join(os.homedir(), '.claude')]).filter(Boolean);
+  let real;
+  try { real = fs.realpathSync(file); } catch { return false; }
+  return roots.some(root => { try { const r = fs.realpathSync(root); return real === r || real.startsWith(r + path.sep); } catch { return false; } });
+}
+
+/** { todayTokens, todayListUsd, allTokens, allListUsd, unpricedTokens, models } for one transcript; null when it cannot be read. `now` fixes the UTC day. */
+export function sessionUsage(file, { now = Date.now() } = {}) {
+  if (typeof file !== 'string' || !file || !allowed(file)) return null;
+  let stat;
+  try { stat = fs.statSync(file); } catch { return null; }
+  if (!stat.isFile()) return null;
+  let hit = cache.get(file);
+  if (!hit || stat.size < hit.offset) { hit = { offset: 0, tail: '', messages: new Map() }; cache.set(file, hit); if (cache.size > 200) cache.delete(cache.keys().next().value); }
+  if (stat.size > hit.offset) {
+    const fd = fs.openSync(file, 'r');
+    try {
+      const want = stat.size - hit.offset;
+      const buffer = Buffer.alloc(want);
+      fs.readSync(fd, buffer, 0, want, hit.offset);
+      const text = hit.tail + buffer.toString('utf8');
+      const lines = text.split('\n');
+      hit.tail = lines.pop() ?? '';
+      hit.offset = stat.size;
+      for (const line of lines) {
+        if (!line || !line.includes('"usage"')) continue;
+        let e; try { e = JSON.parse(line); } catch { continue; }
+        if (e?.type !== 'assistant' || !e.message?.usage) continue;
+        const id = e.message.id ?? `line-${hit.messages.size}`;
+        const u = e.message.usage;
+        const prev = hit.messages.get(id) ?? { at: e.timestamp, family: familyOf(e.message.model), model: e.message.model ?? null, input: 0, output: 0, cacheWrite: 0, cacheRead: 0 };
+        prev.input = Math.max(prev.input, u.input_tokens ?? 0); prev.output = Math.max(prev.output, u.output_tokens ?? 0);
+        prev.cacheWrite = Math.max(prev.cacheWrite, u.cache_creation_input_tokens ?? 0); prev.cacheRead = Math.max(prev.cacheRead, u.cache_read_input_tokens ?? 0);
+        hit.messages.set(id, prev);
+      }
+    } finally { fs.closeSync(fd); }
+  }
+  const dayStart = new Date(now); dayStart.setUTCHours(0, 0, 0, 0);
+  const out = { todayTokens: 0, todayListUsd: 0, allTokens: 0, allListUsd: 0, unpricedTokens: 0, models: [] };
+  const models = new Set();
+  for (const m of hit.messages.values()) {
+    const tokens = m.input + m.output + m.cacheWrite + m.cacheRead;
+    const usd = priceOf(m);
+    if (m.model) models.add(m.model);
+    out.allTokens += tokens;
+    if (usd === null) out.unpricedTokens += tokens; else out.allListUsd += usd;
+    if (Date.parse(m.at) >= dayStart.getTime()) { out.todayTokens += tokens; if (usd !== null) out.todayListUsd += usd; }
+  }
+  out.todayListUsd = Math.round(out.todayListUsd * 1e6) / 1e6; out.allListUsd = Math.round(out.allListUsd * 1e6) / 1e6;
+  out.models = [...models].slice(0, 5);
+  return out;
+}
