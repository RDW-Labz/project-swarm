+    if (age > SESSION_SHOWN_MS * 24) continue;
+    out.push({
+      id: s.id, state, lastAt: s.lastAt, since: state === 'working' ? s.toolStartedAt : state === 'thinking' ? (s.turnStartedAt ?? s.lastAt) : s.lastAt,
+      doing: state === 'working' && s.tool ? { tool: s.tool.name, file: s.tool.file, command: s.tool.command, startedAt: s.toolStartedAt } : null,
