diff --git a/tests/migration-down-dir.test.mjs b/tests/migration-down-dir.test.mjs
new file mode 100644
index 0000000..d36e874
--- /dev/null
+++ b/tests/migration-down-dir.test.mjs
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: Apache-2.0
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { initProject } from '../tools/init.mjs';
+import { validateProfile } from '../tools/init-profile.mjs';
+import { migrationQueueCheck } from '../tools/migration-queue.mjs';
+import { downFileFor } from '../tools/migration-gate.mjs';
+
+// A model of which files `supabase db push` / `supabase migration up` pick up. The CLI lists ONLY the files directly inside supabase/migrations
+// (not subfolders, not sibling folders), keeps the ones named <digits>_<name>.sql, and takes <digits> as the version; two files with the same
+// version are a duplicate-key error. This is the behaviour the parts app hit with 0009.down.sql next to 0009_x.sql (the name part is
+// "x.down"). The real CLI is not run here (it needs Docker and a database); this models its documented file rule.
+async function supabasePushPlan(migrationsDir) {
+  const versions = new Map();
+  for (const entry of await fs.readdir(migrationsDir, { withFileTypes: true })) {
+    if (!entry.isFile()) continue;
+    const match = /^([0-9]+)_(.*)\.sql$/.exec(entry.name);
+    if (!match) continue;
+    if (versions.has(match[1])) throw new Error(`duplicate migration version ${match[1]}: ${versions.get(match[1])} and ${entry.name}`);
+    versions.set(match[1], entry.name);
+  }
+  return [...versions.values()].sort();
+}
+
+async function supabaseProject(t) {
+  const root = await fs.realpath(await fs.mkdtemp(path.join(os.tmpdir(), 'swarm-down-dir-')));
+  t.after(() => fs.rm(root, { recursive: true, force: true }));
+  await fs.mkdir(path.join(root, 'supabase/migrations'), { recursive: true });
+  await fs.writeFile(path.join(root, 'package.json'), '{"name":"x"}');
+  return root;
+}
+const source = process.cwd();
+
+test('supabase db push ignores the down folder: a Supabase project\'s down files never reach the CLI, while sibling files do collide', async t => {
+  const root = await supabaseProject(t);
+  const { profile } = await initProject(root, { source });
+  const config = profile.migrations;
+  assert.equal(config.down, 'dir');
+  const up = 'supabase/migrations/0009_add_x.sql';
+  await fs.writeFile(path.join(root, up), 'create table x (id int);');
+  const down = downFileFor(up, config);
+  assert.equal(down, 'supabase/migrations_down/0009_add_x.sql');
+  await fs.mkdir(path.dirname(path.join(root, down)), { recursive: true });
+  await fs.writeFile(path.join(root, down), 'drop table x;');
+  assert.deepEqual(await supabasePushPlan(path.join(root, 'supabase/migrations')), ['0009_add_x.sql'], 'only the up file is applied');
+  assert.ok(!down.startsWith('supabase/migrations/'), 'the down folder is outside the migrations folder');
+  // The old layout: the sibling down file is a second migration with the same version.
+  await fs.writeFile(path.join(root, 'supabase/migrations/0009_add_x.down.sql'), 'drop table x;');
+  await assert.rejects(supabasePushPlan(path.join(root, 'supabase/migrations')), /duplicate migration version 0009/);
+});
+
+test('the profile accepts down dir with downDir, and down none', () => {
+  assert.deepEqual(validateProfile({ version: 1, migrations: { dir: 'supabase/migrations', down: 'dir' } }).profile?.migrations ?? {}, { dir: 'supabase/migrations', down: 'dir', downDir: 'supabase/migrations_down' });
+  assert.deepEqual(validateProfile({ version: 1, migrations: { dir: 'db/m', down: 'dir', downDir: 'db/d' } }).profile?.migrations, { dir: 'db/m', down: 'dir', downDir: 'db/d' });
+  assert.deepEqual(validateProfile({ version: 1, migrations: { dir: 'db/m', down: 'none' } }).profile?.migrations, { dir: 'db/m', down: 'none' });
+  assert.ok(validateProfile({ version: 1, migrations: { dir: 'supabase/migrations', down: 'dir', downDir: 'supabase/migrations/down' } }).errors.some(e => /separate folder/.test(e)));
+});
+
+test('the merge queue check sees a change in the down folder and checks its migration', async t => {
+  const root = await supabaseProject(t);
+  const profile = { migrations: { dir: 'supabase/migrations', down: 'dir', downDir: 'supabase/migrations_down' } };
+  await fs.writeFile(path.join(root, 'supabase/migrations/0009_a.sql'), 'create table a (id int);');
+  const exec = async () => ({ code: 0, stdout: '', stderr: '' });
+  const missingDown = await migrationQueueCheck({ root, changes: [{ file: 'supabase/migrations/0009_a.sql', bytes: Buffer.from('create table a (id int);') }], profile, exec });
+  assert.match(missingDown.blocks[0].message, /no-down: migration supabase\/migrations\/0009_a\.sql has no down step \(add supabase\/migrations_down\/0009_a\.sql\)/);
+  const withDown = await migrationQueueCheck({ root, changes: [{ file: 'supabase/migrations/0009_a.sql', bytes: Buffer.from('create table a (id int);') }, { file: 'supabase/migrations_down/0009_a.sql', bytes: Buffer.from('drop table a;') }], profile, exec });
+  assert.deepEqual(withDown.blocks, []);
+  // Only the down file changed: its migration is checked again (and an emptied down file blocks).
+  await fs.mkdir(path.join(root, 'supabase/migrations_down'), { recursive: true });
+  await fs.writeFile(path.join(root, 'supabase/migrations_down/0009_a.sql'), '');
+  const downOnly = await migrationQueueCheck({ root, changes: [{ file: 'supabase/migrations_down/0009_a.sql', bytes: Buffer.from('') }], profile, exec });
+  assert.match(downOnly.blocks[0]?.message ?? '', /no-down/);
+});
diff --git a/tests/migration-gate.test.mjs b/tests/migration-gate.test.mjs
index f60ab44..7ea3d40 100644
--- a/tests/migration-gate.test.mjs
+++ b/tests/migration-gate.test.mjs
@@ -273,3 +273,65 @@ test('runRoundTrip hands the commands a short environment', async () => {
   assert.deepEqual(migrationEnv([], { PATH: 'p', OPENAI_API_KEY: 'k', DATABASE_URL: 'db' }), { PATH: 'p' });
   assert.deepEqual(migrationEnv(['DATABASE_URL'], { PATH: 'p', DATABASE_URL: 'db' }), { PATH: 'p', DATABASE_URL: 'db' });
 });
+
+// ---- down: "dir" and down: "none" (parts-app: Supabase reads 0009.down.sql as a duplicate migration; "section" runs the down right after the up) ----
+const dirCfg = (over) => validateMigrationsConfig({ dir: 'supabase/migrations', down: 'dir', ...over });
+test('down dir: the default folder is <dir>_down, the down file has the same name, and the path is mirrored', () => {
+  const r = dirCfg({});
+  assert.equal(r.ok, true, r.errors.join('; '));
+  assert.equal(r.config.downDir, 'supabase/migrations_down');
+  assert.equal(downFileFor('supabase/migrations/0009_add_x.sql', r.config), 'supabase/migrations_down/0009_add_x.sql');
+  assert.equal(downFileFor('supabase/migrations/sub/0010_y.sql', r.config), 'supabase/migrations_down/sub/0010_y.sql');
+  assert.equal(dirCfg({ downDir: 'db/down' }).config.downDir, 'db/down');
+});
+test('down dir: the down folder must be separate (never the migrations folder, inside it, or containing it) and downDir needs down "dir"', () => {
+  for (const downDir of ['supabase/migrations', 'supabase/migrations/down', 'supabase', '../x', '/abs']) {
+    const r = dirCfg({ downDir });
+    assert.equal(r.ok, false, downDir);
+  }
+  assert.ok(validateMigrationsConfig({ dir: 'supabase/migrations', down: 'sibling', downDir: 'x' }).errors.some((e) => e.includes('downDir needs down')));
+  assert.ok(validateMigrationsConfig({ down: 'bogus' }).errors.some((e) => e.includes('sibling, section, dir or none')));
+});
+test('down dir: a missing or empty down file in the down folder is a problem naming the folder; a good one passes; a down-only edit re-checks its migration', async () => {
+  const c = dirCfg({}).config;
+  const up = 'supabase/migrations/0009_a.sql', down = 'supabase/migrations_down/0009_a.sql';
+  const files = new Map([[up, 'create table t (id int);']]);
+  const io = { read: async (f) => Buffer.from(files.get(f) ?? ''), exists: async (f) => files.has(f) };
+  const missing = await checkMigrations({ files: [up], config: c, ...io });
+  assert.equal(missing.problems[0].message, `migration ${up} has no down step (add ${down})`);
+  files.set(down, '-- nothing');
+  assert.equal((await checkMigrations({ files: [up], config: c, ...io })).problems[0].check, 'no-down', 'comment-only down file');
+  files.set(down, 'drop table t;');
+  assert.equal((await checkMigrations({ files: [up], config: c, ...io })).ok, true);
+  // A sibling-style .down.sql next to the migration does NOT count in dir mode.
+  files.delete(down); files.set('supabase/migrations/0009_a.down.sql', 'drop table t;');
+  assert.equal((await checkMigrations({ files: [up], config: c, ...io })).ok, false);
+  // Editing only the down file checks the migration again, and a bad edit is caught.
+  files.set(down, '');
+  assert.equal((await checkMigrations({ files: [down], config: c, ...io })).problems[0].file, up);
+});
+test('down dir: destructive SQL still needs approval, and the approval is bound to the file hash', async () => {
+  const c = dirCfg({}).config;
+  const up = 'supabase/migrations/0010_drop.sql', down = 'supabase/migrations_down/0010_drop.sql';
+  const bytes = Buffer.from('drop table old_things;');
+  const io = { read: async (f) => (f === up ? bytes : Buffer.from('create table old_things (id int);')), exists: async () => true };
+  const need = await checkMigrations({ files: [up], config: c, ...io });
+  assert.equal(need.needsApproval.length, 1);
+  assert.equal((await checkMigrations({ files: [up], config: c, ...io, approvals: [{ file: up, sha256: sha('drop table old_things;') }] })).ok, true);
+  assert.equal((await checkMigrations({ files: [up], config: c, ...io, approvals: [{ file: up, sha256: sha('other') }] })).ok, false);
+  assert.equal(isMigrationFile(down, c), false, 'a down file is never itself a migration');
+});
+test('down none: no down step is required, but the destructive scan and approval still apply', async () => {
+  const r = validateMigrationsConfig({ dir: 'supabase/migrations', down: 'none' });
+  assert.equal(r.ok, true);
+  assert.equal(r.config.downDir, undefined);
+  const up = 'supabase/migrations/0011_a.sql';
+  const safe = await checkMigrations({ files: [up], config: r.config, read: async () => Buffer.from('create table t (id int);'), exists: async () => false });
+  assert.equal(safe.ok, true, JSON.stringify(safe.problems));
+  const bad = await checkMigrations({ files: [up], config: r.config, read: async () => Buffer.from('drop table t;'), exists: async () => false });
+  assert.equal(bad.ok, false);
+  assert.deepEqual(bad.problems.map((p) => p.check), ['needs-approval']);
+  const priv = await checkMigrations({ files: [up], config: r.config, read: async () => Buffer.from('create extension pg_stat_statements;'), exists: async () => false });
+  assert.equal(priv.ok, false, 'privileged SQL still needs approval');
+  assert.equal((await checkMigrations({ files: [up], config: r.config, read: async () => Buffer.from('drop table t;'), exists: async () => false, approvals: [{ file: up, sha256: sha('drop table t;') }] })).ok, true);
+});
