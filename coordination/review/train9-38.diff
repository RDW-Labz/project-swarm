+    `Host mini`,
+    `  HostName ${target.host}`,
+    `  User ${target.user}`,
+    `  IdentityFile ${key}`,
+    `  IdentitiesOnly yes`,
+    `  StrictHostKeyChecking accept-new`,
+    `  ServerAliveInterval 30`,
+    `  ControlMaster auto`,
+    `  ControlPath ~/.ssh/sockets/%r@%h-%p`,
+    `  ControlPersist 10m`,
+  ];
